{
  "$schema": "./schema.json",
  "schema_version": 1,
  "host": "codex",
  "instructions": {
    "source": "recovery/current/hosts/codex/AGENTS.md",
    "target": "{CODEX_HOME}/AGENTS.md",
    "strategy": "generated",
    "required_markers": [
      "[OUTPUT]",
      "[INSTRUCTION-AUTHORING]",
      "[SCOPE]",
      "[EVIDENCE]",
      "[RESEARCH]",
      "[EXECUTION]",
      "[RECONCILIATION]"
    ],
    "projection": {
      "format": "tagged-lines",
      "sections": [
        {
          "label": "OUTPUT",
          "shared": "communication",
          "suffix": "If artifacts changed, add a `Changed:` list with clickable Markdown file links (`[name](/absolute/path)`); for many changes, link one diff or index."
        },
        {
          "label": "INSTRUCTION-AUTHORING",
          "shared": "authoring",
          "suffix": "Codex `.system/skill-creator` owns native scaffolding, UI metadata and validation."
        },
        {
          "label": "SCOPE",
          "shared": "scope"
        },
        {
          "label": "EVIDENCE",
          "shared": "evidence"
        },
        {
          "label": "RESEARCH",
          "shared": "research"
        },
        {
          "label": "EXECUTION",
          "shared": "execution"
        },
        {
          "label": "RECONCILIATION",
          "shared": "reconciliation"
        }
      ]
    }
  },
  "skills": {
    "source": "skills",
    "selection": "registry:admitted",
    "install_root": "{SHARED_SKILLS_HOME}",
    "discovery": {
      "kind": "native",
      "value": "{SHARED_SKILLS_HOME}"
    }
  },
  "routing": {
    "status": "automatic-selection-active-workflow",
    "catalog_schema": "skills/openai-delegation-route-research/references/gpt-route-catalog.schema.json",
    "task_schema": "skills/openai-delegation-route-research/references/route-task.schema.json",
    "selection_contract": "skills/openai-delegation-route-research/references/selection-contract.md",
    "aux_schema": "skills/openai-delegation-route-research/references/aux-models.schema.json",
    "aux_assignments": "skills/openai-delegation-route-research/references/current-aux-models.json",
    "selector": "skills/openai-delegation-route-research/scripts/route_selector.py",
    "receipt_schema": "skills/openai-delegation-route-research/references/route-decision.schema.json",
    "surfaces": [
      {
        "target_surface": "codex-workflow",
        "required_fields": [
          "provider",
          "model",
          "reasoning_effort",
          "decision_receipt"
        ],
        "pinning": "The definitive DAG state selects once at initialization; resume and retries reuse the exact receipt.",
        "native_owner": "skills/dynamic-workflows plus Codex native worker handles",
        "enforcement": "live-skill-adapter",
        "current_support": "Codex atomically claims each routed node before spawn, passes the parent-selected exact model and reasoning effort to the native worker, binds completion to the active handle and claim token, and closes the handle before terminal state. Current JSONL evidence does not independently echo the child resolved route.",
        "smallest_path": "Keep the plugin skill as a thin adapter to skills/dynamic-workflows; do not duplicate the state machine."
      }
    ],
    "unsupported_surfaces": []
  }
}
