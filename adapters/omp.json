{
  "$schema": "./schema.json",
  "schema_version": 1,
  "host": "omp",
  "instructions": {
    "source": "recovery/current/hosts/omp/AGENTS.md",
    "target": "{OMP_HOME}/AGENTS.md",
    "strategy": "generated",
    "required_markers": [
      "[OUTPUT]",
      "[INSTRUCTION-AUTHORING]",
      "[SCOPE]",
      "[EVIDENCE]",
      "[RESEARCH]",
      "[EXECUTION]",
      "[RECONCILIATION]"
    ],
    "projection": {
      "format": "tagged-lines",
      "sections": [
        {
          "label": "OUTPUT",
          "shared": "communication"
        },
        {
          "label": "INSTRUCTION-AUTHORING",
          "shared": "authoring"
        },
        {
          "label": "SCOPE",
          "shared": "scope"
        },
        {
          "label": "EVIDENCE",
          "shared": "evidence"
        },
        {
          "label": "RESEARCH",
          "shared": "research"
        },
        {
          "label": "EXECUTION",
          "shared": "execution"
        },
        {
          "label": "RECONCILIATION",
          "shared": "reconciliation"
        }
      ]
    }
  },
  "skills": {
    "source": "skills",
