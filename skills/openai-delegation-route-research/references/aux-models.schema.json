{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aux-models.schema.json",
  "title": "Purpose-specific auxiliary model assignments",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "version", "observed_at", "assignments"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "status": {"const": "active"},
    "version": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "minLength": 1},
    "assignments": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["purpose", "provider", "model", "timeout_seconds", "decision", "why"],
        "properties": {
          "purpose": {"type": "string", "minLength": 1},
          "provider": {"type": "string", "minLength": 1},
          "model": {"type": "string", "minLength": 1},
          "reasoning_effort": {"enum": ["none", "minimal", "low", "medium", "high", "xhigh", "max", "ultra"]},
          "intelligence_tier": {"enum": ["routine", "standard", "strong", "demanding", "maximum"]},
          "latency_sensitive": {"type": "boolean"},
          "selector_route_id": {"type": "string", "minLength": 1},
          "timeout_seconds": {"type": "integer", "minimum": 1},
          "decision": {"enum": ["retain-incumbent", "automatic-selected", "change-candidate"]},
          "why": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
