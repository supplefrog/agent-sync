{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "route-task-v3.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 3
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "task_class": {
      "type": "string",
      "minLength": 1
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "as_of": {
      "type": "string",
      "format": "date-time"
    },
    "requirements": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "transport": {
          "type": "string",
          "minLength": 1
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "context_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "task_contract_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "reasoning_effort": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "host",
        "transport",
        "tools",
        "context_tokens",
        "task_contract_sha256",
        "model",
        "reasoning_effort"
      ],
      "additionalProperties": false
    },
    "verifier": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "deterministic",
            "independent-review",
            "schema-only",
            "none"
          ]
        },
        "independent": {
          "type": "boolean"
        },
        "coverage": {
          "enum": [
            "complete",
            "partial",
            "none"
          ]
        },
        "scope": {
          "enum": [
            "artifact-effects",
            "independent-review",
            "inline-text"
          ]
        },
        "evidence": {
          "type": "object",
          "properties": {
            "locator": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "locator",
            "sha256"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "independent",
        "coverage",
        "scope",
        "evidence"
      ],
      "additionalProperties": false
    },
    "effects": {
      "enum": [
        "none",
        "reversible",
        "irreversible"
      ]
    },
    "failure_cost": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "deterministic": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "executor_id": {
              "type": "string",
              "minLength": 1
            },
            "artifact_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "task_contract_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "input_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "coverage": {
              "enum": [
                "complete",
                "partial"
              ]
            },
            "effects": {
              "enum": [
                "none",
                "reversible",
                "irreversible"
              ]
            }
          },
          "required": [
            "executor_id",
            "artifact_sha256",
            "task_contract_sha256",
            "input_sha256",
            "coverage",
            "effects"
          ],
          "additionalProperties": false
        }
      ]
    },
    "budget": {
      "type": "object",
      "properties": {
        "objective": {
          "enum": [
            "api_usd",
            "quota"
          ]
        },
        "api_remaining": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "api_reserve": {
          "type": "number",
          "minimum": 0
        },
        "allow_api_spend": {
          "type": "boolean"
        },
        "quotas": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "unit": {
                "type": "string",
                "minLength": 1
              },
              "remaining": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "reserve": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "unit",
              "remaining",
              "reserve"
            ],
            "additionalProperties": false
          }
        },
        "unknown_cost_policy": {
          "enum": [
            "explicit_preference",
            "keep_parent",
            "defer"
          ]
        },
        "preference_order": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "parent_available": {
          "type": "boolean"
        },
        "attempt_cap": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "attempts_used": {
          "type": "integer",
          "minimum": 0
        },
        "fallback_route_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "fallback_route_sha256": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          ]
        }
      },
      "required": [
        "objective",
        "api_remaining",
        "api_reserve",
        "allow_api_spend",
        "quotas",
        "unknown_cost_policy",
        "preference_order",
        "parent_available",
        "attempt_cap",
        "attempts_used",
        "fallback_route_id",
        "fallback_route_sha256"
      ],
      "additionalProperties": false
    },
    "continuation": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "previous_receipt": {
              "type": "object"
            },
            "reason": {
              "enum": [
                "transport-failure",
                "verification-failure"
              ]
            },
            "failure_evidence": {
              "type": "object",
              "properties": {
                "locator": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "locator",
                "sha256"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "previous_receipt",
            "reason",
            "failure_evidence"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "task_class",
    "input_sha256",
    "as_of",
    "requirements",
    "verifier",
    "effects",
    "failure_cost",
    "deterministic",
    "budget",
    "continuation"
  ],
  "additionalProperties": false
}
