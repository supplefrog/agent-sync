{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gpt-route-catalog.schema.json",
  "title": "Reviewed GPT automatic routing catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "catalog_version",
    "provider",
    "source",
    "intelligence_tiers",
    "delegation_candidates",
    "recommendations"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 2},
    "status": {"const": "active"},
    "catalog_version": {"type": "string", "minLength": 1},
    "provider": {"const": "openai-codex"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "observed_at", "metrics"],
      "properties": {
        "name": {"const": "Artificial Analysis"},
        "url": {"type": "string", "pattern": "^https://artificialanalysis\\.ai/"},
        "observed_at": {"type": "string", "minLength": 1},
        "metrics": {
          "const": {
            "intelligence": "Artificial Analysis Intelligence Index",
            "time": "Time per Intelligence Index Task (minutes)",
            "cost": "Cost per Intelligence Index Task (USD)",
            "hallucination": "AA-Omniscience Hallucination Rate (%)"
          }
        }
      }
    },
    "intelligence_tiers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["routine", "standard", "strong", "demanding", "maximum"],
      "properties": {
        "routine": {"$ref": "#/$defs/intelligenceTier"},
        "standard": {"$ref": "#/$defs/intelligenceTier"},
        "strong": {"$ref": "#/$defs/intelligenceTier"},
        "demanding": {"$ref": "#/$defs/intelligenceTier"},
        "maximum": {"$ref": "#/$defs/intelligenceTier"}
      }
    },
    "delegation_candidates": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "model", "reasoning_effort", "artificial_analysis"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "model": {"type": "string", "pattern": "^gpt-"},
          "reasoning_effort": {"enum": ["none", "minimal", "low", "medium", "high", "xhigh", "max"]},
          "artificial_analysis": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "intelligence_index",
              "time_per_task_minutes",
              "cost_per_task_usd",
              "hallucination_rate_percent"
            ],
            "properties": {
              "intelligence_index": {"type": "number", "minimum": 0},
              "time_per_task_minutes": {"type": "number", "exclusiveMinimum": 0},
              "cost_per_task_usd": {"type": "number", "minimum": 0},
              "hallucination_rate_percent": {"type": "number", "minimum": 0, "maximum": 100}
            }
          }
        }
      }
    },
    "recommendations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "route_id", "use_when", "why"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "route_id": {"type": "string", "minLength": 1},
          "use_when": {"type": "string", "minLength": 1},
          "why": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "intelligenceTier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_intelligence_index", "description"],
      "properties": {
        "minimum_intelligence_index": {"type": "number", "minimum": 0},
        "description": {"type": "string", "minLength": 1}
      }
    }
  }
}
