{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Manual delegation route decision receipt",
  "type": "object",
  "required": [
    "schema_version",
    "decision_id",
    "outcome",
    "pin_status",
    "policy_version",
    "policy_sha256",
    "requirement_sha256",
    "target_surface",
    "task_class",
    "objective",
    "failure_cost",
    "attempt_number",
    "constraints_applied",
    "route",
    "metrics",
    "evidence_receipt",
    "excluded",
    "verifier_plan"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "decision_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "outcome": {"enum": ["selected", "fail_closed"]},
    "pin_status": {"enum": ["new", "denied"]},
    "policy_version": {"type": "string", "minLength": 1},
    "policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "requirement_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target_surface": {"enum": ["hermes-delegate", "hermes-task-thread", "hermes-workflow", "codex-workflow", "omp-workflow", "hermes-auxiliary"]},
    "task_class": {"type": "string", "minLength": 1},
    "objective": {"const": "user-outcome"},
    "failure_cost": {"enum": ["low", "medium", "high"]},
    "attempt_number": {"type": "integer", "minimum": 1},
    "constraints_applied": {"type": "object"},
    "route": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["id", "provider", "model", "reasoning_effort", "runtime", "runtime_sha256"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "provider": {"type": "string", "minLength": 1},
            "model": {"type": "string", "minLength": 1},
            "reasoning_effort": {"type": "string", "minLength": 1},
            "runtime": {
              "type": "object",
              "required": ["host", "transport"],
              "properties": {
                "host": {"type": "string", "minLength": 1},
                "transport": {"enum": ["hermes-delegate", "hermes-task-thread", "hermes-workflow", "codex-workflow", "omp-workflow", "hermes-auxiliary"]}
              },
              "minProperties": 2
            },
            "runtime_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          },
          "additionalProperties": false
        }
      ]
    },
    "metrics": {"type": "object"},
    "evidence_receipt": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["locator", "sha256"],
          "properties": {
            "locator": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          },
          "additionalProperties": false
        }
      ]
    },
    "excluded": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}},
    "verifier_plan": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"outcome": {"const": "selected"}}},
      "then": {
        "properties": {
          "pin_status": {"const": "new"},
          "route": {"type": "object"},
          "evidence_receipt": {"type": "object"}
        }
      }
    },
    {
      "if": {"properties": {"outcome": {"const": "fail_closed"}}},
      "then": {
        "properties": {
          "pin_status": {"const": "denied"},
          "route": {"type": "null"},
          "evidence_receipt": {"type": "null"}
        }
      }
    }
  ],
  "additionalProperties": false
}
