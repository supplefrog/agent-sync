{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "records"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "topic", "claim", "status", "evidence", "implication", "observed_at"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "topic": {"type": "string", "minLength": 1},
          "claim": {"type": "string", "minLength": 1},
          "status": {"enum": ["confirmed", "contradicted", "unresolved", "superseded"]},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["kind", "reference"],
              "properties": {
                "kind": {"enum": ["primary-source", "evaluation", "local-verification", "live-profile", "runtime"]},
                "reference": {"type": "string", "minLength": 1},
                "supports": {"type": "boolean", "default": true}
              },
              "additionalProperties": false
            }
          },
          "implication": {"type": "string", "minLength": 1},
          "observed_at": {"type": "string", "format": "date-time"},
          "supersedes": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
