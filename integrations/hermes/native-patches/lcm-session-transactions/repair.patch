+@pytest.mark.parametrize('stored',[False,True])
+def test_known_empty_delayed_end_finalizes_without_changing_rows(tmp_path,stored):
+    obj=engine(tmp_path)
+    try:
+        bind_pair(obj,rows=[{'role':'user','content':'A opener'}] if stored else [])
