+def _scan_cache_fingerprint(skill_path: Path) -> str:
+    """Unambiguous cache identity, separate from the legacy public bundle hash.
+
+    Fixed-size per-file digests frame the relative name and content identity, so
+    bytes inside one file cannot impersonate a later filename/content record.
+    Directory and single-file scans have distinct domains; a single filename
+    matters because scan eligibility depends on its extension.
+    """
+    directory = skill_path.is_dir()
+    files = sorted((p.relative_to(skill_path).as_posix(), p) for p in skill_path.rglob("*") if p.is_file()) if directory else [(skill_path.name, skill_path)]
+    h = hashlib.sha256(SCAN_CACHE_FINGERPRINT_VERSION.encode("ascii") + b"\0" + (b"directory\0" if directory else b"file\0"))
+    for rel, path in files:
+        # Preserve native surrogate code points (POSIX surrogateescape and
+        # Win32 unpaired UTF-16 names) without conflating distinct names.
+        name, content = rel.encode("utf-8", errors="surrogatepass"), path.read_bytes()
+        leaf = hashlib.sha256(b"skills-guard-file-v1\0")
+        leaf.update(len(name).to_bytes(8, "big") + name)
+        leaf.update(len(content).to_bytes(8, "big") + hashlib.sha256(content).digest())
+        h.update(leaf.digest())
+    return h.hexdigest()
+
