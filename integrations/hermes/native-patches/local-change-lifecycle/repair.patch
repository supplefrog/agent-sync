+@pytest.mark.parametrize('staged', [False, True])
+def test_two_ordinary_pulls_preserve_bridge_and_mixed_work(tmp_path, monkeypatch, staged):
+    repo, publisher = fixture(tmp_path)
+    (repo / 'local_bridge.py').write_text("VALUE = 'patched'\ndef bridge():\n    return VALUE\n", encoding='utf-8')
+    patch = tmp_path / 'bridge.patch'
+    patch.write_bytes(subprocess.run(['git', 'diff', '--binary', '--', 'local_bridge.py'], cwd=repo,
+                                     capture_output=True, check=True).stdout)
+    (repo / 'local_bridge.py').write_text("VALUE = 'base'\ndef bridge():\n    return VALUE\n", encoding='utf-8')
+    oracle = tmp_path / 'oracle.py'
+    oracle.write_text(json.dumps({'version': 2, 'path': 'local_bridge.py', 'entry': 'bridge',
+                                  'cases': [{'args': [], 'pass': 'patched', 'failure': 'base'}]}))
+    register(repo, patch, oracle, assertion='bridge')
+    # An unrelated older stash is never replayed or dropped by either update.
+    (repo / "older.txt").write_text("older\n", encoding="utf-8")
+    git(repo, "stash", "push", "-uqm", "older")
+    older = git(repo, "rev-parse", "refs/stash")
+    preserved_stashes = [older]
+    monkeypatch.setattr(update_cmd._m(), "PROJECT_ROOT", repo)
+    monkeypatch.setattr(update_cmd, "_critical_module_import_failures", lambda *a, **k: {})
+    for n in (1, 2):
+        if n == 1:
+            (repo / "local_bridge.py").write_text("VALUE = 'patched'\ndef bridge():\n    return VALUE\n", encoding="utf-8")
+            if staged:
+                git(repo, 'add', 'local_bridge.py')
+            (repo / "mixed.txt").write_text("staged 1\n", encoding="utf-8")
+            git(repo, "add", "mixed.txt")
+            (repo / "mixed.txt").write_text("unstaged 1\n", encoding="utf-8")
+        else:
+            (publisher / 'local_bridge.py').write_text("VALUE = 'patched'\ndef bridge():\n    return VALUE + ''\n", encoding='utf-8')
+        (repo / f"untracked_{n}.txt").write_text("user work\n", encoding="utf-8")
+        advance(repo, publisher, n)
+        stash = update_cmd._stash_local_changes_if_needed(["git"], repo)
+        assert stash and stash != older
+        preserved_stashes.insert(0, stash)
+        update_cmd._pull_updates(["git"], "main", stash, prompt_for_restore=False,
+                                 gw_input_fn=None, discard_local_changes=False,
+                                 keep_stash=False, registration=load(repo))
+        # A different interpreter, born after the pull, imports the retained bridge.
+        child = subprocess.run([sys.executable, "-c", "import local_bridge; print(local_bridge.VALUE)"],
+                               cwd=repo, capture_output=True, text=True, timeout=30)
+        assert child.returncode == 0, child.stderr
+        assert child.stdout.strip() == 'patched'
+        assert git(repo, 'show', ':local_bridge.py') == (
+            "VALUE = 'patched'\ndef bridge():\n    return VALUE" if staged and n == 1 else
+            "VALUE = 'patched'\ndef bridge():\n    return VALUE + ''" if n == 2 else
+            "VALUE = 'base'\ndef bridge():\n    return VALUE")
+        assert git(repo, "show", ":mixed.txt") == 'staged 1'
+        assert (repo / "mixed.txt").read_text(encoding="utf-8") == 'unstaged 1\n'
+        for prior in range(1, n + 1):
+            assert (repo / f"untracked_{prior}.txt").read_text(encoding="utf-8") == "user work\n"
+        # No mutable-index drop: each original remains for identity-safe manual cleanup.
+        assert git(repo, "stash", "list", "--format=%H").splitlines() == preserved_stashes
+        assert receipt(repo)['phase'] == 'complete'
+        assert receipt(repo)['decision'] == ('retain' if n == 1 else 'superseded')
+
