+_DRIVER = r'''
+import os, sys, types
+from pathlib import Path
+from types import SimpleNamespace
+root = Path(sys.argv[1]).resolve()
+sys.path.insert(0, str(root))
+# This acceptance test owns no installed dependency/runtime or services.
+sys.modules['hermes_bootstrap'] = types.ModuleType('hermes_bootstrap')
+from hermes_cli import main, update_cmd
+from hermes_cli.update_inventory import UpdatePlan
+import hermes_cli.update_inventory as inventory
+assert Path(update_cmd.__file__).resolve() == root / 'hermes_cli/update_cmd.py'
+main.PROJECT_ROOT = root
+main._run_pre_update_backup = lambda args: None
+main._pause_windows_gateways_for_update = lambda: None
+main._is_windows = lambda: False
+update_cmd._critical_module_import_failures = lambda *a, **kw: {}
+inventory.collect_runtime_inventory = lambda: UpdatePlan()
+update_cmd._write_fleet_restart_pending_marker = lambda **kw: None
+# Local origin is intentionally not an actual public fork; never probe upstream.
+update_cmd._is_fork = lambda url: False
+with open(os.devnull) as sys.stdin:
+    try:
+        update_cmd._cmd_update_impl(SimpleNamespace(
+            yes=True, gateway=False, no_backup=True, no_gateway_restart=True,
+            branch='main'), False)
+    except SystemExit as exc:
+        if exc.code not in (None, 0):
+            raise
+'''
+
+_COMPLETION = r'''
+if __name__ == '__main__':
+    request = json.loads(Path(sys.argv[1]).read_text(encoding='utf-8-sig'))
