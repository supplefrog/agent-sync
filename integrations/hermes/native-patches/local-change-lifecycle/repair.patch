+"""Update restart guard after a real stash health rejection."""
+
+import json
+import subprocess
+
+import pytest
+
+from hermes_cli import main, update_cmd, update_cmd_windows, update_receipt
+
+
+def _git(repo, *args):
+    return subprocess.run(
+        ["git", *args], cwd=repo, capture_output=True, text=True,
+        encoding="utf-8", errors="replace", check=True, timeout=30,
+    ).stdout.strip()
+
+
+def _repo(path):
+    _git(path, "init", "-q", "-b", "main")
+    _git(path, "config", "user.email", "t@example.com")
+    _git(path, "config", "user.name", "t")
+    (path / "tracked.txt").write_text("base\n", encoding="utf-8")
+    _git(path, "add", "tracked.txt")
+    _git(path, "commit", "-qm", "base")
+    return path
+
+
+def _stub_pull_external_effects(monkeypatch, repo, *, refuse=False):
+    monkeypatch.setattr(main, "PROJECT_ROOT", repo)
+    monkeypatch.setattr(update_cmd, "_capture_head_sha", lambda *args: _git(repo, "rev-parse", "HEAD"))
+    # Pull transport is inert here; this suite owns restore/resume, not HEAD movement.
+    monkeypatch.setattr(update_cmd, "_verify_head_after_pull", lambda *a, **k: _git(repo, "rev-parse", "HEAD"))
+    original = update_cmd._git_run
+    def local_git(command, args, *rest, **kwargs):
+        if args[:2] == ["merge", "--ff-only"]:
+            return subprocess.CompletedProcess(args, 0, "", "")
+        return original(command, args, *rest, **kwargs)
+    monkeypatch.setattr(update_cmd, "_git_run", local_git)
+
+    def check_pulled_code(*args):
+        if refuse:
+            raise SystemExit(1)
+
+    monkeypatch.setattr(update_cmd, "_rollback_if_pulled_syntax_error", check_pulled_code)
+
+
+def test_real_stash_health_rejection_suppresses_resume_and_finalizes_failure(tmp_path, monkeypatch):
+    repo = _repo(tmp_path)
+    (repo / "broken.py").write_text("def broken(:\n", encoding="utf-8")
+    _git(repo, "stash", "push", "-u", "-qm", "saved")
+    stash_ref = _git(repo, "rev-parse", "refs/stash")
+    _stub_pull_external_effects(monkeypatch, repo)
+    monkeypatch.setattr(update_cmd, "_critical_module_import_failures", lambda *a, **k: {})
+    monkeypatch.setattr(update_receipt, "_receipt_dir", lambda: tmp_path / "receipts")
+    monkeypatch.setattr(update_receipt, "_code_identity", lambda **kwargs: {})
+    token = {"resume_needed": True, "profiles": {"default": {}}, "unmapped": []}
+    receipt_token = update_receipt._current.set(None)
+    update_receipt.begin_update_receipt()
+
+    try:
+        with pytest.raises(SystemExit) as error:
+            update_cmd._pull_updates(
+                ["git"], "main", stash_ref, prompt_for_restore=False, gw_input_fn=None,
+                discard_local_changes=False, keep_stash=False, _windows_gateway_resume=token,
+            )
+        assert error.value.code == 1
+        assert token["resume_needed"] is True
+        assert token["auto_resume_suppressed"] is True
+        assert (repo / "broken.py").read_text(encoding="utf-8") == "def broken(:\n"
+        assert _git(repo, "rev-parse", "refs/stash") == stash_ref
+        assert _git(repo, "status", "--porcelain")
+
+        def unexpected_windows_probe():
+            raise AssertionError("automatic resume reached Windows gateway work")
+
+        monkeypatch.setattr(main, "_refresh_windows_gateway_launchers", unexpected_windows_probe)
+        update_cmd_windows._resume_windows_gateways_after_update(token)
+        receipt_path = update_receipt.finalize_pending_update_receipt(1, "sys.exit(1)")
+        receipt = json.loads(receipt_path.read_text(encoding="utf-8"))
+        assert receipt["outcome"] == "failed"
+        assert receipt["exit_code"] == 1
+        assert receipt["gateway_restart"]["incomplete"] is True
+        assert "Paused profiles: default" in receipt["gateway_restart"]["phase_error"]
+        assert any(
+            step["name"] == "local_changes_stash" and not step["ok"]
+            for step in receipt["steps"]
+        )
+    finally:
+        update_receipt._current.reset(receipt_token)
+
+
+@pytest.mark.parametrize("refuse", [True, False])
+def test_safe_pull_paths_leave_resume_available(tmp_path, monkeypatch, refuse):
+    repo = _repo(tmp_path)
+    _stub_pull_external_effects(monkeypatch, repo, refuse=refuse)
+    token = {"resume_needed": True, "profiles": {}, "unmapped": []}
+    if refuse:
+        with pytest.raises(SystemExit) as error:
+            update_cmd._pull_updates(
+                ["git"], "main", "saved", prompt_for_restore=False, gw_input_fn=None,
+                discard_local_changes=False, keep_stash=True, _windows_gateway_resume=token,
+            )
+        assert error.value.code == 1
+    else:
+        update_cmd._pull_updates(
+            ["git"], "main", "saved", prompt_for_restore=False, gw_input_fn=None,
+            discard_local_changes=False, keep_stash=True, _windows_gateway_resume=token,
