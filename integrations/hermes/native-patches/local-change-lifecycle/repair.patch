+def advance(repo, publisher, n):
+    (publisher / f"upstream_{n}.txt").write_text(f"release {n}\n", encoding="utf-8")
+    git(publisher, "add", ".")
+    git(publisher, "commit", "-qm", f"upstream {n}")
+    git(publisher, "push", "-q", "origin", "main")
+    git(repo, "fetch", "-q", "origin", "main")
