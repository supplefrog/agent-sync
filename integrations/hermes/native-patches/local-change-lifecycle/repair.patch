+    assert receipt(repo)['phase'] == phase if phase else receipt(repo) is None
+    if phase:
+        assert receipt(repo)['original'] == saved
+    from hermes_cli import update_cmd_windows
+    update_cmd_windows._resume_windows_gateways_after_update(token)
+    assert token['auto_resume_suppressed'] is True
+    monkeypatch.setattr(lifecycle, 'write_receipt', original_write)
+    monkeypatch.setattr(update_cmd_stash, '_git_quiet', original_git)
+    monkeypatch.setattr(registry, 'settle_retirement', original_retire)
+    if phase == 'pending':
+        with pytest.raises(_UnsafeStashRestore):
+            main.cmd_update(SimpleNamespace(yes=True, gateway=False, no_backup=True, branch='main'))
