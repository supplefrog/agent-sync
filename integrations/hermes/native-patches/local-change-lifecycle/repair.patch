+@pytest.mark.parametrize('case', ['keep_unreadable', 'discard_unreadable', 'decline_unreadable',
+                                  'keep_missing_during_capture', 'restore_missing_during_capture',
+                                  'valid', 'invalid'])
+def test_already_current_registered_disposition_matrix(tmp_path, monkeypatch, case):
+    repo, publisher, marker = setup(tmp_path, monkeypatch)
+    manifest = register_bridge(repo, tmp_path)
+    (repo / 'local_bridge.py').write_text("VALUE = 'patched'\ndef bridge():\n    return VALUE\n")
+    (repo / 'mixed.txt').write_text('saved residual\n')
+    location = registration_path(repo)
+    if case.endswith('unreadable'):
+        location.unlink()
+        location.mkdir()
+    elif case == 'invalid':
+        (location.parent / 'objects' / manifest['oracle_sha256']).write_bytes(b'changed')
+    elif case.endswith('missing_during_capture'):
+        read = Path.read_bytes
+        def disappear(path):
+            if path == location:
+                path.unlink()
+                raise FileNotFoundError('registration disappeared during capture')
+            return read(path)
+        monkeypatch.setattr(Path, 'read_bytes', disappear)
+    if case.startswith('discard'):
+        monkeypatch.setattr(update_cmd, '_updates_config', lambda: {'non_interactive_local_changes': 'discard'})
+    if case.startswith('decline'):
+        monkeypatch.setattr(sys.stdin, 'isatty', lambda: True)
+        monkeypatch.setattr(sys.stdout, 'isatty', lambda: True)
+        monkeypatch.setattr('builtins.input', lambda *a: 'n')
+    calls = []
+    prepare = lifecycle.prepare
+    def track_prepare(*args, **kwargs):
+        calls.append(True)
+        return prepare(*args, **kwargs)
+    monkeypatch.setattr(lifecycle, 'prepare', track_prepare)
+    result = 0
+    try:
+        main.cmd_update(SimpleNamespace(yes=not case.startswith('decline'), gateway=False,
+            no_backup=True, no_gateway_restart=True, branch='main', keep_stash=case.startswith('keep')))
+    except SystemExit as exc:
+        result = exc.code
+    record = lifecycle.receipt(repo)
+    saved = git(repo, 'stash', 'list', '--format=%H')
+    assert saved
+    assert marker.exists() == (result == 0)
+    if case == 'valid':
+        assert result == 0 and calls and record['phase'] == 'complete' and record['decision'] == 'retain'
+        assert lifecycle._settlement(repo, record)
+        assert (repo / 'mixed.txt').read_text() == 'saved residual\n'
+    else:
+        assert not calls and record is None and (repo / 'mixed.txt').read_text() == 'base\n'
+        assert (repo / 'local_bridge.py').read_text() == "VALUE = 'base'\ndef bridge():\n    return VALUE\n"
+        assert result == (1 if case in ('invalid', 'restore_missing_during_capture') else 0)
+    update_receipt._current.set(None)
