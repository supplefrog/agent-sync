+def git(repo, *args):
+    return subprocess.run(["git", "-c", "core.autocrlf=false", *args], cwd=repo,
+                          capture_output=True, text=True, encoding="utf-8",
+                          check=True, timeout=30).stdout.strip()
+
+
+def fixture(tmp_path):
+    remote = tmp_path / "origin.git"
+    remote.mkdir()
+    git(remote, "init", "-q", "--bare")
+    repo = tmp_path / "checkout"
+    repo.mkdir()
+    git(repo, "init", "-q", "-b", "main")
+    git(repo, "config", "user.name", "Test")
+    git(repo, "config", "user.email", "test@example.invalid")
+    git(repo, "config", "core.autocrlf", "false")
+    git(repo, "remote", "add", "origin", str(remote))
+    (repo / "local_bridge.py").write_text("VALUE = 'base'\ndef bridge():\n    return VALUE\n", encoding="utf-8")
+    (repo / "mixed.txt").write_text("base\n", encoding="utf-8")
+    git(repo, "add", ".")
+    git(repo, "commit", "-qm", "base")
+    git(repo, "push", "-q", "-u", "origin", "main")
+    publisher = tmp_path / "publisher"
+    git(tmp_path, "clone", "-q", str(remote), str(publisher))
+    git(publisher, "checkout", "-q", "main")
+    git(publisher, "config", "user.name", "Publisher")
+    git(publisher, "config", "user.email", "publisher@example.invalid")
+    return repo, publisher
+
