+"""Evaluate a registered patch and prepare saved-tree retirement in disposable Git storage.
+
+Never apply a registered patch to the updating checkout. The only real-checkout
+mutation belongs to the existing stash restoration mechanism.
+"""
+from __future__ import annotations
+
+from contextlib import contextmanager
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import shutil
+import stat
+import subprocess
+import tempfile
+
+from hermes_cli.update_cmd_patch_registry import RegistrationError, _check_oracle, _git as source_git, load
+
+
+class LifecycleError(ValueError):
+    pass
+
+
+def remove_store(store: str | Path) -> None:
+    """Remove the disposable object store, including Git's read-only Windows objects."""
+    def writable_then_retry(func, name, error):
+        os.chmod(name, stat.S_IWRITE | stat.S_IREAD)
+        func(name)
+    shutil.rmtree(Path(store).parent, onerror=writable_then_retry)
+
+
+def _run(repo: Path, *args: str, data: bytes | None = None, env: dict | None = None,
+         allowed: tuple[int, ...] = (0,)) -> bytes:
+    result = subprocess.run(['git', '--no-replace-objects', '-c', f'core.hooksPath={os.devnull}', '-C', str(repo), *args],
+                            input=data, capture_output=True, env=env, timeout=60)
+    if result.returncode not in allowed:
+        raise LifecycleError(f'git {args[0]} failed: {result.stderr.decode("utf-8", "replace")[:180]}')
+    return result.stdout
+
+
+def _oid(repo: Path, value: str) -> str:
+    return _run(repo, 'rev-parse', '--verify', value).decode().strip()
+
+
+def _entries(repo: Path, tree: str) -> dict[str, tuple[str, str]]:
+    result = {}
+    for row in _run(repo, 'ls-tree', '-r', '-z', tree).split(b'\0'):
+        if row:
+            metadata, path = row.split(b'\t', 1)
+            mode, kind, oid = metadata.split(b' ')
+            if kind != b'blob':
+                raise LifecycleError('unsupported saved tree entry')
+            result[path.decode('utf-8', 'surrogateescape')] = (mode.decode(), oid.decode())
+    return result
+
+
+@contextmanager
+def _checkout(repo: Path, commit: str):
+    root = Path(tempfile.mkdtemp(prefix='hermes-patch-evidence-'))
+    checkout = root / 'checkout'
+    added = False
+    try:
+        _run(repo, 'worktree', 'add', '--detach', str(checkout), commit)
+        added = True
+        yield checkout
+    finally:
+        if added:
+            _run(repo, 'worktree', 'remove', '--force', str(checkout))
+        shutil.rmtree(root)
+
+
+def _apply(checkout: Path, patch: bytes):
+    _run(checkout, 'apply', '--check', '-', data=patch)
+    _run(checkout, 'apply', '-', data=patch)
+
+
+def _oracle(checkout: Path, manifest: dict, oracle: bytes) -> str:
+    """Run exactly the registered standalone source with a private temporary script."""
+    if hashlib.sha256(oracle).hexdigest() != manifest['oracle_sha256']:
+        raise LifecycleError('oracle changed')
+    before = (_run(checkout, 'ls-files', '-s', '-z'),
+              _run(checkout, 'diff', '--no-ext-diff', '--no-textconv', '--binary', 'HEAD', '--'))
+    from hermes_cli.update_cmd_patch_oracle import OracleError, observe
+    try:
+        spec = _check_oracle(oracle, manifest['allowed_paths'])
+        status = observe(checkout, spec, manifest['runner'], manifest['timeout'])
+    except (RegistrationError, OracleError) as exc:
+        raise LifecycleError(f'oracle evaluation unresolved: {exc}') from exc
+    after = (_run(checkout, 'ls-files', '-s', '-z'),
+             _run(checkout, 'diff', '--no-ext-diff', '--no-textconv', '--binary', 'HEAD', '--'))
+    if after != before:
+        raise LifecycleError('oracle mutated tracked state')
+    return status
+
+
+def evaluate(repo: Path, target: str, manifest: dict, patch: bytes, oracle: bytes,
+             *, check_active: bool = True) -> str:
+    """Independent base/target behavioral evidence, only in disposable checkouts."""
+    if check_active and load(repo) != (manifest, patch, oracle):
+        raise LifecycleError('registration changed')
+    if check_active and _oid(repo, 'HEAD') != target:
+        raise LifecycleError('target HEAD changed')
+    ancestor = subprocess.run(['git', '-C', str(repo), 'merge-base', '--is-ancestor', manifest['base'], target],
+                              capture_output=True, timeout=30)
+    if ancestor.returncode:
+        raise LifecycleError('registered base is not target ancestor')
+    with _checkout(repo, manifest['base']) as base:
+        if _oracle(base, manifest, oracle) != 'expected_failure':
+            raise LifecycleError('base did not exhibit registered failure')
+        _apply(base, patch)
+        if _oracle(base, manifest, oracle) != 'pass':
+            raise LifecycleError('patched base did not pass')
+    with _checkout(repo, target) as current:
+        status = _oracle(current, manifest, oracle)
+        if status == 'pass':
