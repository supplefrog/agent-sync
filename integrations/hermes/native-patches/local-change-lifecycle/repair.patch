+"""Parent-owned full-entry interruption and untracked-only replay checks."""
+
+import subprocess
+from pathlib import Path
+
+import pytest
+
+from hermes_cli import update_cmd, update_cmd_stash
+
+
+def _git(repo, *args):
+    return subprocess.run(
+        ["git", *args], cwd=repo, capture_output=True, text=True,
+        encoding="utf-8", check=True, timeout=30,
+    ).stdout.strip()
+
+
+def _repo(path):
+    _git(path, "init", "-q", "-b", "main")
+    _git(path, "config", "user.email", "t@example.com")
+    _git(path, "config", "user.name", "t")
+    (path / "tracked.txt").write_text("base\n", encoding="utf-8")
+    _git(path, "add", "tracked.txt")
+    _git(path, "commit", "-qm", "base")
+    return path
+
+
+@pytest.mark.parametrize("failure", ["nonzero", "timeout", "unknown_index"])
+def test_real_apply_uncertainty_stops_and_retains_state(tmp_path, monkeypatch, failure):
+    repo = _repo(tmp_path)
+    tracked = repo / "tracked.txt"
+    tracked.write_text("saved\n", encoding="utf-8")
+    _git(repo, "stash", "push", "-qm", "saved")
+    stash_ref = _git(repo, "rev-parse", "refs/stash")
+    monkeypatch.setattr(update_cmd, "_critical_module_import_failures", lambda *a, **k: {})
+    original = update_cmd_stash._git_quiet
+    receipts = []
+    monkeypatch.setattr(update_cmd_stash, "_record_stash_disposition", lambda *args: receipts.append(args))
+    applied = False
+
+    def uncertain_result(git_cmd, args, cwd, **kwargs):
+        nonlocal applied
+        if Path(cwd) == repo and args[:3] == ["stash", "apply", "--index"]:
+            result = original(git_cmd, args, cwd, **kwargs)
+            assert result.returncode == 0
+            applied = True
+            # A concurrent editor's work must not be reset or cleaned.
+            tracked.write_text("new editor work\n", encoding="utf-8")
+            (repo / "unrelated.bin").write_bytes(b"\x00new")
+            if failure == "timeout":
+                return None
+            if failure == "nonzero":
+                return subprocess.CompletedProcess(args, 1, "", "simulated late failure")
+            return result
+        if applied and Path(cwd) == repo and args[:2] == ["ls-files", "--unmerged"]:
+            return None
+        return original(git_cmd, args, cwd, **kwargs)
+
+    monkeypatch.setattr(update_cmd_stash, "_git_quiet", uncertain_result)
+    with pytest.raises(SystemExit) as exc:
+        update_cmd_stash._restore_stashed_changes(["git"], repo, stash_ref)
+    assert exc.value.code == 1 and applied
+    assert tracked.read_text(encoding="utf-8") == "new editor work\n"
+    assert (repo / "unrelated.bin").read_bytes() == b"\x00new"
+    assert _git(repo, "rev-parse", "refs/stash") == stash_ref
+    assert receipts[-1][0:2] == ("parked", stash_ref)
+    monkeypatch.setattr(update_cmd_stash, "_git_quiet", original)
+    assert not update_cmd_stash._restore_stashed_changes(["git"], repo, stash_ref)
+    assert tracked.read_text(encoding="utf-8") == "new editor work\n"
+
