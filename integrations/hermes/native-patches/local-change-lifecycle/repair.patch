+from hermes_cli.update_cmd_patch_registry import register, load, RegistrationError, registration_path, _check_oracle
+from hermes_cli.update_cmd_patch_lifecycle import prepare, LifecycleError, remove_store
+
+
+def git(repo, *args):
+    result = subprocess.run(['git', '-c', 'core.autocrlf=false', *args], cwd=repo,
+                            capture_output=True, check=True, timeout=30)
+    return result.stdout.decode('utf-8', 'replace').strip()
