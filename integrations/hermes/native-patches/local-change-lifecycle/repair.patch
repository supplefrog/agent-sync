+"""Real Git invariants for the native update stash restore preflight."""
+
+import subprocess
+
+import pytest
+
+from hermes_cli import update_cmd_stash
+
+
+def _git(repo, *args):
+    return subprocess.run(
+        ["git", *args], cwd=repo, capture_output=True, text=True, check=True,
+    ).stdout.strip()
+
+
+def _repo(tmp_path):
+    _git(tmp_path, "init", "-q", "-b", "main")
+    _git(tmp_path, "config", "user.email", "t@example.com")
+    _git(tmp_path, "config", "user.name", "t")
+    (tmp_path / "tracked.txt").write_text("base\n", encoding="utf-8")
+    _git(tmp_path, "add", "tracked.txt")
+    _git(tmp_path, "commit", "-qm", "base")
+    return tmp_path
+
+
+def _snapshot(repo):
+    return (
+        _git(repo, "rev-parse", "HEAD"),
+        _git(repo, "ls-files", "--stage"),
+        _git(repo, "status", "--porcelain"),
+        (repo / "tracked.txt").read_bytes(),
+        (repo / "binary.bin").read_bytes() if (repo / "binary.bin").exists() else None,
+        _git(repo, "stash", "list", "--format=%H"),
+    )
+
+
+def test_apply_preserves_index_worktree_and_binary_then_refuses_repeat(tmp_path):
+    repo = _repo(tmp_path)
+    tracked = repo / "tracked.txt"
+    binary = repo / "binary.bin"
+    tracked.write_text("staged\n", encoding="utf-8")
+    _git(repo, "add", "tracked.txt")
+    tracked.write_text("unstaged\n", encoding="utf-8")
+    payload = b"\x00\xff\x80saved\x00"
+    binary.write_bytes(payload)
+    _git(repo, "stash", "push", "-u", "-qm", "update")
+    stash_ref = _git(repo, "rev-parse", "refs/stash")
+
+    assert update_cmd_stash._apply_stash(["git"], repo, stash_ref)
+    assert _git(repo, "show", ":tracked.txt") == "staged"
+    assert tracked.read_text(encoding="utf-8") == "unstaged\n"
+    assert binary.read_bytes() == payload
+    assert stash_ref in _git(repo, "stash", "list", "--format=%H")
+    before_repeat = _snapshot(repo)
+
+    assert not update_cmd_stash._apply_stash(["git"], repo, stash_ref)
+    assert _snapshot(repo) == before_repeat
+
+
+@pytest.mark.parametrize("case", ["identical", "different", "tracked_conflict", "preparation_failure"])
+def test_refusal_preserves_real_checkout_and_stash(tmp_path, monkeypatch, capsys, case):
+    repo = _repo(tmp_path)
+    (repo / "tracked.txt").write_text("saved edit\n", encoding="utf-8")
+    saved_binary = b"\x00\xffsaved"
+    (repo / "binary.bin").write_bytes(saved_binary)
+    _git(repo, "stash", "push", "-u", "-qm", "update")
+    stash_ref = _git(repo, "rev-parse", "refs/stash")
+
+    if case in ("identical", "different"):
+        (repo / "binary.bin").write_bytes(
+            saved_binary if case == "identical" else b"\x00\xffdifferent"
+        )
+    elif case == "tracked_conflict":
+        (repo / "tracked.txt").write_text("updated upstream\n", encoding="utf-8")
+        _git(repo, "add", "tracked.txt")
+        _git(repo, "commit", "-qm", "update")
+    else:
+        original = update_cmd_stash._git_quiet
+
+        def fail_preparation(git_cmd, args, cwd, **kwargs):
+            if args[:2] == ["worktree", "add"]:
+                return None
+            return original(git_cmd, args, cwd, **kwargs)
+
+        monkeypatch.setattr(update_cmd_stash, "_git_quiet", fail_preparation)
+
+    before = _snapshot(repo)
+    assert not update_cmd_stash._apply_stash(["git"], repo, stash_ref)
+    assert _snapshot(repo) == before
+    assert stash_ref in _git(repo, "stash", "list", "--format=%H")
+    if case in ("identical", "different"):
+        # Both are refused without reading existing contents; equality cannot
+        # establish whether this is a repeated restore or unrelated work.
+        output = capsys.readouterr().out
+        assert "binary.bin" in output and "already exists" in output
