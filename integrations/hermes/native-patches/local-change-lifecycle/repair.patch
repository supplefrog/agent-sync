+def spec(*, passing='patched', failure='base'):
+    return validate_spec(json.dumps({
+        'version': 2, 'path': 'bridge.py', 'entry': 'bridge',
+        'cases': [{'args': [], 'pass': passing, 'failure': failure}],
+    }).encode())
+
+
+def observe_source(tmp_path, source, oracle=None):
+    (tmp_path / 'bridge.py').write_text(source, encoding='utf-8')
+    import sys
+    return observe(tmp_path, oracle or spec(), sys.executable, 5)
+
+
+@pytest.mark.parametrize(('source', 'outcome'), [
+    ("VALUE = 'base'\ndef bridge():\n    return VALUE\n", 'expected_failure'),
+    ("VALUE = 'patched'\ndef bridge():\n    return VALUE\n", 'pass'),
+    ("VALUE = 'patched'\ndef bridge():\n    return VALUE + ''\n", 'pass'),
+    ("VALUE = 'patched'\ndef bridge():\n    return 'base'\n", 'expected_failure'),
+    ("VALUE = 'patched'\ndef bridge():\n    if VALUE == 'patched':\n        return 'wrong'\n    return VALUE\n", 'unresolved'),
+    ("VALUE = 'patched'\ndef bridge():\n    return 'surprise'\n", 'unresolved'),
+])
