+"""Settled history must validate any active replacement before optional parking.
+
+For retain/absent, retire() deliberately constructs the supported exact-retired
+historical evidence shape; it is not an automatic non-retiring update transition.
+Superseded reaches that shape through the ordinary update retirement path.
+"""
+import json
+import subprocess
+from types import SimpleNamespace
+
+import pytest
+
+from hermes_cli import main
+from hermes_cli import update_cmd_patch_lifecycle as lifecycle
+from hermes_cli import update_cmd_patch_registry as registry
+from tests.hermes_cli.test_update_cmd_patch_acceptance import (
+    advance, git, register_bridge, setup, update,
+)
+
+
+@pytest.mark.parametrize('decision', ['retain', 'absent', 'superseded'])
+@pytest.mark.parametrize('corruption', ['manifest', 'content'])
+def test_retired_history_requires_valid_active_replacement(tmp_path, monkeypatch, decision, corruption):
+    repo, publisher, marker = setup(tmp_path, monkeypatch)
+    manifest = register_bridge(repo, tmp_path)
+    if decision != 'absent':
+        (repo / 'local_bridge.py').write_text("VALUE = 'patched'\ndef bridge():\n    return VALUE\n")
+    (repo / 'mixed.txt').write_text('saved index\n')
+    git(repo, 'add', 'mixed.txt')
+    (repo / 'mixed.txt').write_text('saved worktree\n')
+    (repo / 'untracked.bin').write_bytes(b'saved\x00bytes')
+    advance(publisher, 1, fix=decision == 'superseded')
+    update(repo, marker, expected_behavior='base' if decision == 'absent' else 'patched')
+    record = lifecycle.receipt(repo)
+    assert record['decision'] == decision
+    settlement = lifecycle.receipt_path(repo).with_name('completed-' + record['original'] + '.json')
+    assert json.loads(settlement.read_text()) == {
+        'kind': 'verified-restore-settlement', 'version': 1, 'receipt': record,
+    }
+    location = registry.registration_path(repo)
+    retired = location.with_name('retired-' + manifest['registration_id'] + '.json')
+    if decision != 'superseded':
+        # Exact historical evidence, not a claim that retain/absent retires itself.
+        registry.retire(repo, manifest)
+    assert json.loads(retired.read_text()) == manifest
+
+    # No active registration is valid with exact retired evidence; never recreate it.
+    assert not location.exists()
+    assert lifecycle.recover(repo) == record
+    assert not location.exists()
+
+    saved_source = (repo / 'local_bridge.py').read_bytes()
+    (repo / 'local_bridge.py').write_text("VALUE = 'replacement'\ndef bridge():\n    return VALUE\n")
+    patch = tmp_path / 'replacement.diff'
+    patch.write_bytes(subprocess.run(
+        ['git', 'diff', '--binary', '--', 'local_bridge.py'], cwd=repo,
+        capture_output=True, check=True, timeout=30,
+    ).stdout)
+    oracle = tmp_path / 'replacement.json'
+    oracle.write_text(json.dumps({
+        'version': 2, 'path': 'local_bridge.py', 'entry': 'bridge',
+        'cases': [{'args': [], 'pass': 'replacement',
+                   'failure': 'patched' if decision == 'superseded' else 'base'}],
+    }))
+    replacement = registry.register(repo, patch, oracle, assertion='replacement')
+    (repo / 'local_bridge.py').write_bytes(saved_source)
+    assert replacement['registration_id'] != manifest['registration_id']
+    replacement_bytes = location.read_bytes()
+    assert lifecycle.recover(repo) == record
+    assert registry.load(repo)[0] == replacement
+    assert location.read_bytes() == replacement_bytes
+    assert not location.with_name('retired-' + replacement['registration_id'] + '.json').exists()
+
+    if corruption == 'manifest':
+        location.write_text('{}')
+    else:
+        # A syntactically valid, sealed replacement still needs verified content.
+        assert replacement['oracle_sha256'] != manifest['oracle_sha256']
+        (location.parent / 'objects' / replacement['oracle_sha256']).write_bytes(b'{}')
+    evidence = {path: path.read_bytes() for path in (location, retired, settlement, lifecycle.receipt_path(repo))}
+    head = git(repo, 'rev-parse', 'HEAD')
+    stack = git(repo, 'stash', 'list', '--format=%H')
+    assert record['original'] in stack.splitlines()
+    marker.unlink()
+    advance(publisher, 2)
+
+    # Mandatory recovery must refuse even when the next command only parks work.
+    with pytest.raises((lifecycle.LifecycleError, registry.RegistrationError)):
+        lifecycle.recover(repo)
+    with pytest.raises(SystemExit) as exited:
+        main.cmd_update(SimpleNamespace(yes=True, gateway=False, no_backup=True,
+                                       no_gateway_restart=True, branch='main', keep_stash=True))
+    assert exited.value.code != 0
+    assert not marker.exists()
+    assert git(repo, 'rev-parse', 'HEAD') == head
+    assert git(repo, 'stash', 'list', '--format=%H') == stack
+    assert git(repo, 'show', ':mixed.txt') == 'saved index'
+    assert (repo / 'mixed.txt').read_text() == 'saved worktree\n'
+    assert (repo / 'local_bridge.py').read_bytes() == saved_source
+    assert (repo / 'untracked.bin').read_bytes() == b'saved\x00bytes'
+    assert {path: path.read_bytes() for path in evidence} == evidence
