+"""Real publication/retirement interruptions retain work and never replay it.
+
+Adapted from the independent settlement probes. Only persistence boundaries and
+unsafe service/install leaves are intercepted; Git, preflight and recovery run.
+"""
+
+import atexit
+import json
+import os
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+from hermes_cli import main, update_cmd_stash, update_cmd_windows, update_receipt
+from hermes_cli import update_cmd_patch_lifecycle as lifecycle
+from hermes_cli import update_cmd_patch_registry as registry
+from hermes_cli.update_cmd_stash import _UnsafeStashRestore
+from tests.hermes_cli.test_update_cmd_patch_acceptance import (
+    advance, git, register_bridge, setup,
+)
+
+
+@pytest.fixture(autouse=True)
+def _clear_update_receipt():
+    yield
+    update_receipt._current.set(None)
+
+
+def _args():
+    return SimpleNamespace(yes=True, gateway=False, no_backup=True,
+                           no_gateway_restart=True, branch='main')
+
+
+def _saved_work(tmp_path, monkeypatch):
+    repo, publisher, marker = setup(tmp_path, monkeypatch)
+    manifest = register_bridge(repo, tmp_path)
+    (repo / 'local_bridge.py').write_text("VALUE = 'patched'\ndef bridge():\n    return VALUE\n")
+    (repo / 'mixed.txt').write_text('saved index\n')
+    git(repo, 'add', 'mixed.txt')
+    (repo / 'mixed.txt').write_text('saved worktree\n')
+    (repo / 'untracked.bin').write_bytes(b'saved\x00')
+    advance(publisher, 1, fix=True)
+    return repo, publisher, marker, manifest
+
+
+def _count_applies(monkeypatch, repo):
+    real = update_cmd_stash._git_quiet
+    calls = []
+
+    def observe(command, args, cwd, **kwargs):
+        # Reconstruction applies to disposable worktrees, not the user's checkout.
+        if Path(cwd) == repo and args[:3] == ['stash', 'apply', '--index']:
+            calls.append(list(args))
+        return real(command, args, cwd, **kwargs)
+
+    monkeypatch.setattr(update_cmd_stash, '_git_quiet', observe)
+    return calls
+
+
+def _assert_work(repo, record, *, later=False):
+    prefix = 'later' if later else 'saved'
+    assert git(repo, 'show', ':mixed.txt') == prefix + ' index'
+    assert (repo / 'mixed.txt').read_text() == prefix + ' worktree\n'
+    assert (repo / 'untracked.bin').read_bytes() == b'saved\x00'
+    assert record['original'] in git(repo, 'stash', 'list', '--format=%H').splitlines()
+
+
+def _later_work(repo, publisher, record):
+    advance(publisher, 2)
+    git(repo, 'pull', '--ff-only', 'origin', 'main')
+    assert git(repo, 'rev-parse', 'HEAD') != record['target']
+    (repo / 'mixed.txt').write_text('later index\n')
+    git(repo, 'add', 'mixed.txt')
+    (repo / 'mixed.txt').write_text('later worktree\n')
+
+
+def _assert_recovered(repo, record, manifest, calls, *, later):
+    assert lifecycle.recover(repo) == record
+    assert lifecycle.recover(repo) == record
+    archive = lifecycle.receipt_path(repo).with_name('completed-' + record['original'] + '.json')
+    assert json.loads(archive.read_text()) == {
+        'kind': 'verified-restore-settlement', 'version': 1, 'receipt': record,
+    }
+    active = registry.registration_path(repo)
+    assert not active.exists()
+    retired = active.with_name('retired-' + manifest['registration_id'] + '.json')
+    assert json.loads(retired.read_text()) == manifest
+    _assert_work(repo, record, later=later)
+    with pytest.raises(_UnsafeStashRestore):
+        update_cmd_stash._apply_stash(['git'], repo, record['original'])
+    assert calls == []
+    _assert_work(repo, record, later=later)
+
+
+@pytest.mark.parametrize('edge', ['fsync', 'before_replace', 'after_replace', 'readback'])
+def test_settlement_publication_interruption_recovers_without_replay(tmp_path, monkeypatch, edge):
+    repo, publisher, marker, manifest = _saved_work(tmp_path, monkeypatch)
+    calls = _count_applies(monkeypatch, repo)
+    real_replace = lifecycle.os.replace
+    real_read = lifecycle._read_receipt_file
+    real_mkstemp = lifecycle.tempfile.mkstemp
+    real_fsync = lifecycle.os.fsync
+    temporary = {}
+    published = []
+    injected = []
+
+    def mkstemp(*args, **kwargs):
+        fd, name = real_mkstemp(*args, **kwargs)
+        temporary[fd] = Path(name)
+        return fd, name
+
+    def fsync(fd):
+        path = temporary.get(fd)
+        # Identify the actual flushed settlement file, not the pending/complete
+        # writer or unrelated fsync calls sharing the same os module.
+        if edge == 'fsync' and path is not None and path.parent == lifecycle.receipt_path(repo).parent:
+            payload = json.loads(path.read_text())
+            if payload.get('kind') == 'verified-restore-settlement':
+                injected.append('fsync')
+                raise OSError('settlement fsync interrupted')
+        return real_fsync(fd)
+
+    def replace(source, destination):
+        if Path(destination).name.startswith('completed-'):
+            if edge == 'before_replace':
+                injected.append(edge)
+                raise OSError('before settlement replace')
+            real_replace(source, destination)
+            published.append(Path(destination))
+            if edge == 'after_replace':
+                injected.append(edge)
+                raise OSError('after settlement replace')
+            return
+        return real_replace(source, destination)
+
+    def read(path):
+        if edge == 'readback' and Path(path) in published:
+            injected.append(edge)
+            raise OSError('settlement readback interrupted')
+        return real_read(path)
+
+    with monkeypatch.context() as fault:
+        fault.setattr(lifecycle.tempfile, 'mkstemp', mkstemp)
+        fault.setattr(lifecycle.os, 'fsync', fsync)
+        fault.setattr(lifecycle.os, 'replace', replace)
+        fault.setattr(lifecycle, '_read_receipt_file', read)
+        with pytest.raises(_UnsafeStashRestore) as failed:
+            main.cmd_update(_args())
+    assert failed.value.code == 1 and injected == [edge]
+    assert len(calls) == 1
+    calls.clear()
+    record = json.loads(lifecycle.receipt_path(repo).read_text())
+    archive = lifecycle.receipt_path(repo).with_name('completed-' + record['original'] + '.json')
+    settled = edge in ('after_replace', 'readback')
+    assert record['phase'] == 'complete' and record['decision'] == 'superseded'
+    assert archive.exists() == settled
+    assert not marker.exists() and registry.load(repo)[0] == manifest
+    _assert_work(repo, record)
+    if settled:
+        # Caller failure after durable publication must not erase historical authority.
+        _later_work(repo, publisher, record)
+    _assert_recovered(repo, record, manifest, calls, later=settled)
+    assert not marker.exists()
+
+
+@pytest.mark.parametrize('edge', ['before_move', 'after_move'])
+def test_actual_retirement_move_interruption_recovers_without_replay(tmp_path, monkeypatch, edge):
+    repo, publisher, marker, manifest = _saved_work(tmp_path, monkeypatch)
+    calls = _count_applies(monkeypatch, repo)
+    active = registry.registration_path(repo)
+    retired = active.with_name('retired-' + manifest['registration_id'] + '.json')
+    real_replace = registry.os.replace
+    injected = []
+
+    def replace(source, destination):
+        if Path(source) == active and Path(destination) == retired:
+            injected.append(edge)
+            if edge == 'after_move':
+                real_replace(source, destination)
+            raise OSError('retirement move interrupted')
+        return real_replace(source, destination)
+
+    with monkeypatch.context() as fault:
+        fault.setattr(registry.os, 'replace', replace)
+        with pytest.raises(_UnsafeStashRestore) as failed:
+            main.cmd_update(_args())
+    assert failed.value.code == 1 and injected == [edge]
+    assert len(calls) == 1
+    calls.clear()
+    record = lifecycle.receipt(repo)
+    assert record['phase'] == 'complete' and record['decision'] == 'superseded'
+    assert lifecycle._settlement(repo, record)
+    assert active.exists() == (edge == 'before_move')
+    assert retired.exists() == (edge == 'after_move')
+    assert json.loads((active if active.exists() else retired).read_text()) == manifest
+    assert not marker.exists()
+    _assert_work(repo, record)
+    _later_work(repo, publisher, record)
+    _assert_recovered(repo, record, manifest, calls, later=True)
+    assert not marker.exists()
+
+
+@pytest.mark.platforms("windows")
+def test_retirement_cancellation_captured_exit_callback_never_resumes(tmp_path, monkeypatch):
+    repo, publisher, marker, manifest = _saved_work(tmp_path, monkeypatch)
