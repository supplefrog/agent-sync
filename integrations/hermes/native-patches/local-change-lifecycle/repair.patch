+    def interrupted_write(path, record):
+        if boundary == 'before_pending' and record['phase'] == 'pending':
+            raise OSError('before pending persistence')
+        original_write(path, record)
+        if ((boundary == 'completion_write' and record['phase'] == 'complete') or
+                (boundary == 'after_pending' and record['phase'] == 'pending')):
+            raise OSError('interrupted after receipt persistence')
+
+    def interrupted_apply(command, args, cwd, **kwargs):
+        if boundary == 'after_apply' and Path(cwd) == repo and args[:3] == ['stash', 'apply', '--index']:
+            result = original_git(command, args, cwd, **kwargs)
+            assert result.returncode == 0
+            raise OSError('interrupted after actual application')
+        return original_git(command, args, cwd, **kwargs)
+
+    if boundary == 'after_completion':
+        monkeypatch.setattr(registry, 'settle_retirement', lambda *args: (_ for _ in ()).throw(OSError('before retirement')))
+    monkeypatch.setattr(lifecycle, 'write_receipt', interrupted_write)
+    monkeypatch.setattr(update_cmd_stash, '_git_quiet', interrupted_apply)
+    token = {'resume_needed': True, 'profiles': {}, 'unmapped': []}
