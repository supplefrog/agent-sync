+    git("add", "-A")
+    git("commit", "-qm", "init")
+
+    (tmp_path / "tracked.txt").write_text("v2 local change\n")
+    pkg = tmp_path / "packaging" / "homebrew"
+    pkg.mkdir(parents=True)
