+def test_unsafe_restore_on_already_current_path_suppresses_resume(monkeypatch, tmp_path):
+    def reject(*args, **kwargs):
+        raise _UnsafeStashRestore(1)
+
+    monkeypatch.setattr(update_cmd, "_m", lambda: SimpleNamespace(
+        PROJECT_ROOT=tmp_path, _restore_stashed_changes=reject))
+    token = {"resume_needed": True}
+    plan = SimpleNamespace(auto_stash_ref="saved", prompt_for_restore=False)
+    with pytest.raises(_UnsafeStashRestore):
+        update_cmd._finish_already_up_to_date(
+            ["git"], "main", "main", plan, gw_input_fn=None, completion_request=None, _windows_gateway_resume=token)
+    assert token["auto_resume_suppressed"] is True
