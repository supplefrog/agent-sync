+@pytest.mark.parametrize('staged', [False, True])
+def test_registered_patch_saved_tree_and_residual(tmp_path, staged):
+    repo = tmp_path / 'repo'
+    repo.mkdir()
+    git(repo, 'init', '-q', '-b', 'main')
+    git(repo, 'config', 'user.name', 'Test')
+    git(repo, 'config', 'user.email', 'test@example.invalid')
+    (repo / 'bridge.py').write_text("VALUE = 'base'\ndef bridge():\n    return VALUE\n")
+    (repo / 'residual.txt').write_text('base\n')
+    git(repo, 'add', '.')
+    git(repo, 'commit', '-qm', 'base')
+    (repo / 'bridge.py').write_text("VALUE = 'patched'\ndef bridge():\n    return VALUE\n")
+    patch = tmp_path / 'patch.diff'
+    patch.write_bytes(subprocess.run(['git', 'diff', '--binary', '--', 'bridge.py'], cwd=repo,
