+"""Disposable cmd_update acceptance: real Git, registration, oracle, stash and handoff."""
+import json
+import os
+import subprocess
+import sys
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+from hermes_cli import main, update_cmd, update_cmd_stash, update_receipt
+from hermes_cli import update_cmd_patch_lifecycle as lifecycle
+from hermes_cli import update_cmd_patch_registry as registry
+from hermes_cli.update_cmd_patch_lifecycle import LifecycleError, completed_original, receipt, receipt_path, write_receipt
+from hermes_cli.update_cmd_patch_registry import load, register, registration_path
+from hermes_cli.update_cmd_stash import _UnsafeStashRestore
+from hermes_cli.update_inventory import UpdatePlan
+
+
+# Only dependency/product/service completion is synthetic; the parent updater,
+# source swap, lifecycle oracle, stash restoration and child transport are real.
+COMPLETION_STUB = """import json, os, sys, subprocess
+from pathlib import Path
+request = json.loads(Path(sys.argv[1]).read_text())
+root = Path(request['source'])
+sys.path.insert(0, str(root))
+import local_bridge
+Path(os.environ['HERMES_TEST_COMPLETION_MARKER']).write_text(json.dumps({
+    'pid': os.getpid(), 'path': local_bridge.__file__, 'behavior': local_bridge.bridge(),
+    'head': subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=root, text=True).strip()}))
+terminal = dict(request['receipt'], finished_at='test-completed', outcome='success')
+Path(sys.argv[2]).write_text(json.dumps({'schema': 1,
+    'update_id': request['receipt']['update_id'], 'exit_code': 0,
+    'receipt': terminal, 'windows_resume': None, 'pm_receipt': None}))
+"""
+
+
+def git(repo, *args):
+    return subprocess.run(['git', '-c', 'core.autocrlf=false', *args], cwd=repo,
+                          capture_output=True, text=True, check=True, timeout=30).stdout.strip()
+
+
+def setup(tmp_path, monkeypatch):
+    remote = tmp_path / 'origin.git'
+    git(tmp_path, 'init', '-q', '--bare', str(remote))
+    repo = tmp_path / 'checkout'
+    repo.mkdir()
+    git(repo, 'init', '-q', '-b', 'main')
+    for key, value in [('user.name', 'Test'), ('user.email', 'test@example.invalid'),
+                       ('core.autocrlf', 'false')]:
+        git(repo, 'config', key, value)
+    git(repo, 'remote', 'add', 'origin', str(remote))
+    (repo / 'local_bridge.py').write_text("VALUE = 'base'\ndef bridge():\n    return VALUE\n")
+    (repo / 'mixed.txt').write_text('base\n')
+    (repo / 'hermes_cli').mkdir()
+    (repo / 'hermes_cli' / 'update_completion.py').write_text(COMPLETION_STUB)
+    git(repo, 'add', '.')
+    git(repo, 'commit', '-qm', 'base')
+    git(repo, 'push', '-q', '-u', 'origin', 'main')
+    publisher = tmp_path / 'publisher'
+    git(tmp_path, 'clone', '-q', str(remote), str(publisher))
+    git(publisher, 'checkout', '-q', 'main')
+    git(publisher, 'config', 'user.name', 'Publisher')
+    git(publisher, 'config', 'user.email', 'publisher@example.invalid')
+    home = tmp_path / 'home'
+    home.mkdir()
+    monkeypatch.setenv('HERMES_HOME', str(home))
+    monkeypatch.setenv('PYTHONPATH', str(Path(__file__).resolve().parents[2]))
+    assert Path(update_cmd.__file__).resolve() == (Path(__file__).resolve().parents[2] / 'hermes_cli' / 'update_cmd.py')
+    monkeypatch.setattr('hermes_cli.update_owning_install.retarget_to_owning_install', lambda root: None)
+    monkeypatch.setattr(main, 'PROJECT_ROOT', repo)
+    monkeypatch.setattr(main, '_run_pre_update_backup', lambda args: None)
+    monkeypatch.setattr(main, '_is_windows', lambda: False)
+    monkeypatch.setattr(main, '_pause_windows_gateways_for_update', lambda: None)
+    monkeypatch.setattr(update_cmd, '_critical_module_import_failures', lambda *a, **kw: {})
+    monkeypatch.setattr('hermes_cli.update_inventory.collect_runtime_inventory', lambda: UpdatePlan())
+    # Exercise the current stdlib completion transport in a fresh child. The
+    # disposable checkout replaces only package installation/service completion.
+    marker = tmp_path / 'child.json'
+    monkeypatch.setenv('HERMES_TEST_COMPLETION_MARKER', str(marker))
+    monkeypatch.setattr(update_cmd, '_write_fleet_restart_pending_marker', lambda **kw: None)
+    return repo, publisher, marker
+
+
+def advance(publisher, n, *, fix=False):
+    (publisher / f'release_{n}.txt').write_text(f'release {n}\n')
+    if fix:
+        # Deliberately different bytes than the registered patch, same oracle behavior.
+        (publisher / 'local_bridge.py').write_text("VALUE = 'patched'\ndef bridge():\n    return VALUE + ''\n")
+    git(publisher, 'add', '.')
+    git(publisher, 'commit', '-qm', f'upstream {n}')
+    git(publisher, 'push', '-q', 'origin', 'main')
+
+
+def register_bridge(repo, tmp_path, *, passing='patched', failure='base'):
+    (repo / 'local_bridge.py').write_text("VALUE = 'patched'\ndef bridge():\n    return VALUE\n")
+    patch = tmp_path / 'bridge.diff'
+    patch.write_bytes(subprocess.run(['git', 'diff', '--binary', '--', 'local_bridge.py'],
+                                     cwd=repo, capture_output=True, check=True).stdout)
+    (repo / 'local_bridge.py').write_text("VALUE = 'base'\ndef bridge():\n    return VALUE\n")
+    oracle = tmp_path / 'oracle.py'
+    oracle.write_text(json.dumps({'version': 2, 'path': 'local_bridge.py', 'entry': 'bridge',
+                                  'cases': [{'args': [], 'pass': passing, 'failure': failure}]}))
+    return register(repo, patch, oracle, assertion='bridge')
+
+
+def update(repo, marker, *, expected_behavior='patched'):
+    marker.unlink(missing_ok=True)
+    with open(os.devnull, 'r') as stdin, pytest.MonkeyPatch.context() as patched:
+        patched.setattr(sys, 'stdin', stdin)
+        main.cmd_update(SimpleNamespace(yes=True, gateway=False, no_backup=True,
+                                        no_gateway_restart=True, branch='main'))
+    child = json.loads(marker.read_text())
+    assert child['pid'] != os.getpid()
+    assert child['head'] == git(repo, 'rev-parse', 'HEAD')
+    assert Path(child['path']).resolve() == (repo / 'local_bridge.py').resolve()
+    assert child['behavior'] == expected_behavior
+
+@pytest.mark.parametrize('decision', ['retain', 'superseded'])
+@pytest.mark.parametrize('staged', [False, True])
+def test_settled_history_allows_later_independent_staged_and_worktree_edits(tmp_path, monkeypatch, decision, staged):
+    repo, publisher, marker = setup(tmp_path, monkeypatch)
+    register_bridge(repo, tmp_path)
+    (repo / 'local_bridge.py').write_text("VALUE = 'patched'\ndef bridge():\n    return VALUE\n")
+    if staged:
+        git(repo, 'add', 'local_bridge.py')
+    (repo / 'mixed.txt').write_text('first residual\n')
+    (repo / 'untracked.bin').write_bytes(b'original bytes\x00')
+    advance(publisher, 1, fix=decision == 'superseded')
+    update(repo, marker)
+    previous = receipt(repo)
+    assert previous['decision'] == decision
+    (repo / 'mixed.txt').write_text('later staged residual\n')
+    git(repo, 'add', 'mixed.txt')
+    (repo / 'mixed.txt').write_text('later worktree residual\n')
+    advance(publisher, 2)
+    update(repo, marker)
+    assert git(repo, 'show', ':mixed.txt') == 'later staged residual'
+    assert (repo / 'mixed.txt').read_text() == 'later worktree residual\n'
+    assert (repo / 'untracked.bin').read_bytes() == b'original bytes\x00'
+    assert previous['original'] in git(repo, 'stash', 'list', '--format=%H')
+    assert completed_original(repo, previous['original'])
+    with pytest.raises(_UnsafeStashRestore):
+        update_cmd_stash._apply_stash(['git'], repo, previous['original'])
+
+def test_absent_settlement_allows_later_residual_edits_without_installing_patch(tmp_path, monkeypatch):
