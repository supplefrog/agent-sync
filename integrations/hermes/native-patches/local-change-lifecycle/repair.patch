+"""Committed updater survives real, local-only in-place source updates.
+
+All Git operations target disposable repositories. Runtime activation, package
+installation and service completion are substituted; the source/stash pipeline
+and fresh-child completion transport are the production implementation. The
+fixture retains updater/CLI/PM source and root Python modules, omitting unrelated
+application and publication assets. Every imported updater owner is from that tree.
+"""
+import io
+import json
+import os
+from pathlib import Path
+import shutil
+import signal
+import subprocess
+import sys
+import tarfile
+
+import pytest
+
+
+def _git(repo, *args):
+    hooks = Path(repo).parent / 'selfhost-empty-hooks'
+    hooks.mkdir(exist_ok=True)
+    result = subprocess.run(
+        ['git', '-c', 'core.autocrlf=false', '-c', 'core.longpaths=true',
+         '-c', f'core.hooksPath={hooks}', *args],
+        cwd=repo, capture_output=True, text=True, timeout=60,
+    )
+    assert result.returncode == 0, result.stdout + result.stderr
+    return result.stdout.strip()
+
+
+def _update_child(command, repo, env):
+    child = subprocess.Popen(command, cwd=repo, env=env, stdout=subprocess.PIPE,
+                             stderr=subprocess.PIPE, text=True, start_new_session=os.name != 'nt')
+    try:
+        stdout, stderr = child.communicate(timeout=240)
+    except subprocess.TimeoutExpired:
+        if os.name == 'nt':
+            # The venv launcher can own another Python/Git process. Kill only
+            # the tree rooted at this freshly created disposable child PID.
+            subprocess.run(['taskkill', '/PID', str(child.pid), '/T', '/F'],
+                           capture_output=True, timeout=15)
+        else:
+            os.killpg(child.pid, signal.SIGKILL)
+        child.communicate(timeout=15)
+        raise
+    return subprocess.CompletedProcess(command, child.returncode, stdout, stderr)
+
