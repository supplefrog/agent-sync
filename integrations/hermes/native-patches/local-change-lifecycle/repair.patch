+    assert observe_source(tmp_path, base, spec(passing='base', failure='wrong')) == 'pass'
+    # An always-passing oracle cannot satisfy the lifecycle's expected-failure base gate.
+    assert observe_source(tmp_path, "def bridge():\n    return 'base'\n",
