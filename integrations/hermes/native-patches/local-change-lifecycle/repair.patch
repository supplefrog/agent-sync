+"""Real Git invariants for bounded native update stash restoration."""
+
+import shutil
+import subprocess
+from pathlib import Path
+
+import pytest
+
+from hermes_cli import update_cmd, update_cmd_stash
+
+
+def _git(repo, *args):
+    return subprocess.run(
+        ["git", *args], cwd=repo, capture_output=True, text=True,
+        encoding="utf-8", errors="replace", check=True, timeout=30,
+    ).stdout.strip()
+
+
+def _repo(path):
+    _git(path, "init", "-q", "-b", "main")
+    _git(path, "config", "user.email", "t@example.com")
+    _git(path, "config", "user.name", "t")
+    (path / "tracked.txt").write_text("base\n", encoding="utf-8")
+    _git(path, "add", "tracked.txt")
+    _git(path, "commit", "-qm", "base")
+    return path
+
+
+def _registry(repo):
+    return _git(repo, "worktree", "list", "--porcelain")
+
+
+def test_full_restore_preserves_index_and_retains_original_stash(tmp_path, monkeypatch):
+    repo = _repo(tmp_path)
+    (repo / "earlier.bin").write_bytes(b"earlier")
+    _git(repo, "stash", "push", "-u", "-qm", "unrelated")
+    unrelated = _git(repo, "rev-parse", "refs/stash")
+    tracked = repo / "tracked.txt"
+    tracked.write_text("staged\n", encoding="utf-8")
+    _git(repo, "add", "tracked.txt")
+    tracked.write_text("unstaged\n", encoding="utf-8")
+    payload = b"\x00\xff\x80saved\x00"
+    (repo / "binary.bin").write_bytes(payload)
+    _git(repo, "stash", "push", "-u", "-qm", "intended")
+    intended = _git(repo, "rev-parse", "refs/stash")
+    (repo / "upstream.txt").write_text("advanced HEAD\n", encoding="utf-8")
+    _git(repo, "add", "upstream.txt")
+    _git(repo, "commit", "-qm", "nonconflicting upstream")
+    advanced_head = _git(repo, "rev-parse", "HEAD")
+    before_registry = _registry(repo)
+    monkeypatch.setattr(update_cmd, "_critical_module_import_failures", lambda *a, **k: {})
+
+    assert update_cmd_stash._restore_stashed_changes(
+        ["git", "-c", "windows.appendAtomically=false"], repo, intended,
+    )
+    assert _git(repo, "show", ":tracked.txt") == "staged"
+    assert tracked.read_text(encoding="utf-8") == "unstaged\n"
+    assert (repo / "binary.bin").read_bytes() == payload
+    assert _git(repo, "rev-parse", "HEAD") == advanced_head
+    assert (repo / "upstream.txt").read_text(encoding="utf-8") == "advanced HEAD\n"
+    assert _git(repo, "stash", "list", "--format=%H").splitlines() == [intended, unrelated]
+    assert _registry(repo) == before_registry
+
+
+def test_conflicting_preflight_leaves_registry_checkout_and_stash_unchanged(tmp_path):
+    repo = _repo(tmp_path)
+    (repo / "tracked.txt").write_text("saved\n", encoding="utf-8")
+    _git(repo, "stash", "push", "-qm", "saved")
+    stash_ref = _git(repo, "rev-parse", "refs/stash")
+    (repo / "tracked.txt").write_text("upstream\n", encoding="utf-8")
+    _git(repo, "add", "tracked.txt")
+    _git(repo, "commit", "-qm", "upstream")
+    before_registry = _registry(repo)
+
+    assert not update_cmd_stash._apply_stash(["git"], repo, stash_ref)
+    assert _registry(repo) == before_registry
+    assert (repo / "tracked.txt").read_text(encoding="utf-8") == "upstream\n"
+    assert _git(repo, "rev-parse", "refs/stash") == stash_ref
+
+
+@pytest.mark.parametrize("failure", ["partial_add", "remove"])
+def test_preflight_cleanup_reports_own_path(tmp_path, monkeypatch, capsys, failure):
+    repo = _repo(tmp_path)
+    (repo / "tracked.txt").write_text("saved\n", encoding="utf-8")
+    _git(repo, "stash", "push", "-qm", "saved")
+    stash_ref = _git(repo, "rev-parse", "refs/stash")
+    head = _git(repo, "rev-parse", "HEAD")
+    before_registry = _registry(repo)
+    original = update_cmd_stash._git_quiet
+    captured = {}
+
+    def intercept(git_cmd, args, cwd, **kwargs):
+        if args[:2] == ["worktree", "add"]:
+            captured["checkout"] = Path(args[3])
+            result = original(git_cmd, args, cwd, **kwargs)
+            if failure == "partial_add":
+                return subprocess.CompletedProcess(args, 1, "", "simulated partial add")
+            return result
+        if failure == "remove" and args[:2] == ["worktree", "remove"]:
+            return subprocess.CompletedProcess(args, 1, b"", b"simulated removal failure")
+        return original(git_cmd, args, cwd, **kwargs)
+
+    monkeypatch.setattr(update_cmd_stash, "_git_quiet", intercept)
+    assert not update_cmd_stash._preflight_stash_apply(["git"], repo, stash_ref, head)
+    checkout = captured["checkout"]
+    assert str(checkout) in capsys.readouterr().out
+    assert _git(repo, "rev-parse", "refs/stash") == stash_ref
+    if failure == "partial_add":
+        assert _registry(repo) == before_registry
+        assert not checkout.exists()
+    else:
+        assert checkout.as_posix() in _registry(repo)
+        assert checkout.exists()
+        _git(repo, "worktree", "remove", "--force", str(checkout))
+        shutil.rmtree(checkout.parent)
+        assert _registry(repo) == before_registry
+
+
+def test_repository_local_git_override_refuses_without_mutating_either_repo(tmp_path, monkeypatch):
+    (tmp_path / "first").mkdir()
+    first = _repo(tmp_path / "first")
+    (tmp_path / "second").mkdir()
+    second = _repo(tmp_path / "second")
+    (first / "tracked.txt").write_text("saved\n", encoding="utf-8")
+    _git(first, "stash", "push", "-qm", "saved")
+    stash_ref = _git(first, "rev-parse", "refs/stash")
+    first_before = (first / "tracked.txt").read_bytes()
+    second_before = (second / "tracked.txt").read_bytes()
+    monkeypatch.setenv("GIT_INDEX_FILE", str(second / ".git" / "index"))
+
+    assert not update_cmd_stash._restore_stashed_changes(["git"], first, stash_ref)
+    assert (first / "tracked.txt").read_bytes() == first_before
+    assert (second / "tracked.txt").read_bytes() == second_before
+    monkeypatch.delenv("GIT_INDEX_FILE")
+    assert _git(first, "rev-parse", "refs/stash") == stash_ref
+    assert _git(first, "status", "--porcelain") == ""
+    assert _git(second, "status", "--porcelain") == ""
