+"""Real-Git history isolation and conservative raw-v2 archive compatibility.
+
+History lookup is deny-replay evidence, not permission to migrate arbitrary old
+archives. Only the ordinary restore path creates the settlements used as controls.
+"""
+
+import hashlib
+import json
+import subprocess
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+from hermes_cli import main, update_cmd_stash, update_receipt
+from hermes_cli import update_cmd_patch_lifecycle as lifecycle
+from hermes_cli import update_cmd_patch_registry as registry
+from hermes_cli.update_cmd_stash import _UnsafeStashRestore
+from tests.hermes_cli.test_update_cmd_patch_acceptance import (
+    advance,
+    git,
+    register_bridge,
+    setup,
+    update,
+)
+
+
+
+
+@pytest.fixture(autouse=True)
+def _clear_command_receipt():
+    # A refused command must not leave the process-global reporter in another row.
+    update_receipt._current.set(None)
+    yield
+    update_receipt._current.set(None)
+
+
+def _archive(repo, record):
+    return lifecycle.receipt_path(repo).with_name(
+        'completed-' + record['original'] + '.json')
+
+
+def _git_bytes(repo, *args):
+    return subprocess.run(
+        ['git', '-c', 'core.autocrlf=false', *args], cwd=repo,
+        capture_output=True, check=True, timeout=30,
+    ).stdout
+
+
+def _layers(repo, label):
+    (repo / 'mixed.txt').write_bytes((label + ' index\n').encode())
+    git(repo, 'add', 'mixed.txt')
+    (repo / 'mixed.txt').write_bytes((label + ' worktree\n').encode())
+    (repo / 'untracked.bin').write_bytes(label.encode() + b'\x00\xff')
+
+
+def _assert_layers(repo, label):
+    assert _git_bytes(repo, 'show', ':mixed.txt') == (label + ' index\n').encode()
+    assert (repo / 'mixed.txt').read_bytes() == (label + ' worktree\n').encode()
+    assert (repo / 'untracked.bin').read_bytes() == label.encode() + b'\x00\xff'
+
+
+def _state(repo):
+    """Independent byte-level preservation oracle for retry and direct restore."""
+    return {
+        'head': git(repo, 'rev-parse', 'HEAD'),
+        'index': _git_bytes(repo, 'ls-files', '--stage', '-z'),
+        'staged': _git_bytes(repo, 'diff', '--cached', '--binary'),
+        'unstaged': _git_bytes(repo, 'diff', '--binary'),
+        'status': _git_bytes(repo, 'status', '--porcelain', '-z', '-uall'),
+        'stack': _git_bytes(repo, 'stash', 'list', '--format=%H'),
+        'untracked': ((repo / 'untracked.bin').read_bytes()
+                      if (repo / 'untracked.bin').exists() else None),
+        'evidence': {p.name: p.read_bytes()
+                     for p in lifecycle.receipt_path(repo).parent.glob('*.json')},
+    }
+
+
+def _first_settlement(tmp_path, monkeypatch):
+    repo, publisher, marker = setup(tmp_path, monkeypatch)
+    manifest = register_bridge(repo, tmp_path)
+    (repo / 'older.bin').write_bytes(b'older saved work\x00')
+    git(repo, 'stash', 'push', '-uqm', 'unrelated older work')
+    older = git(repo, 'rev-parse', 'refs/stash')
+    (repo / 'local_bridge.py').write_text(
+        "VALUE = 'patched'\ndef bridge():\n    return VALUE\n", encoding='utf-8')
+    _layers(repo, 'first')
+    advance(publisher, 1)
+    update(repo, marker)
+    record = lifecycle.receipt(repo)
+    assert record['phase'] == 'complete' and record['decision'] == 'retain'
+    assert json.loads(_archive(repo, record).read_text(encoding='utf-8')) == {
+        'kind': 'verified-restore-settlement', 'version': 1, 'receipt': record,
+    }
+    assert registry.load(repo)[0] == manifest
+    _assert_layers(repo, 'first')
+    marker.unlink()
+    return repo, publisher, marker, manifest, record, older
+
+
+def _count_checkout_applies(monkeypatch, repo):
+    real_git = update_cmd_stash._git_quiet
+    calls = []
+
+    def counted(command, args, cwd, **kwargs):
+        if Path(cwd) == repo and args[:3] == ['stash', 'apply', '--index']:
+            calls.append(tuple(args))
+        return real_git(command, args, cwd, **kwargs)
+
+    monkeypatch.setattr(update_cmd_stash, '_git_quiet', counted)
+    return calls
+
+
+@pytest.mark.parametrize('boundary', ['before_apply', 'after_apply'])
+def test_old_settlement_does_not_settle_new_pending_same_registration(
+    tmp_path, monkeypatch, boundary,
+):
+    repo, publisher, marker, manifest, old, older = _first_settlement(tmp_path, monkeypatch)
