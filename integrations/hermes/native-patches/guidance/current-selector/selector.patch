diff --git a/tests/agent/test_selective_skill_guidance.py b/tests/agent/test_selective_skill_guidance.py
new file mode 100644
index 0000000000..b6802071dc
--- /dev/null
+++ b/tests/agent/test_selective_skill_guidance.py
@@ -0,0 +1,33 @@
+"""The skill catalog supplies needed knowledge without ordering blanket loading or learning."""
+from types import SimpleNamespace
+
+from agent import prompt_builder, system_prompt
+
+
+def test_interactive_skill_catalog_preserves_discovery_without_blanket_loading(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    monkeypatch.delenv("HERMES_SINGLE_QUERY_SESSION", raising=False)
+    skill = tmp_path / "skills" / "device-protocol"
+    skill.mkdir(parents=True)
+    (skill / "SKILL.md").write_text(
+        "---\nname: device-protocol\ndescription: Exact device commands and required interlocks\n---\n"
+        "Read the interlock before issuing the device command.\n", encoding="utf-8")
+    prompt = prompt_builder.build_skills_system_prompt(
+        available_tools={"skill_view", "skill_manage", "terminal"},
+        skills_dir_override=tmp_path / "skills")
+    assert "device-protocol" in prompt
+    assert "skill_view" in prompt
+    assert "even partially relevant" not in prompt
+    assert "MUST load" not in prompt
+    assert "Err on the side of loading" not in prompt
+    assert "After difficult/iterative tasks" not in prompt
+
+
+def test_skill_maintenance_guidance_keeps_pruned_reload_without_success_based_writes():
+    agent = SimpleNamespace(valid_tool_names={"skill_manage", "memory"}, _kanban_worker_guidance="")
+    prompt = system_prompt._tool_guidance_block(agent)
+    assert "[SKILL_PRUNED]" in prompt
+    assert "skill_view" in prompt
+    assert "record it with skill_manage" not in prompt
+    assert "Skills come first: when you learn" not in prompt
+    assert "explicit user request" in prompt
