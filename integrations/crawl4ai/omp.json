{
  "mcpServers": {
    "crawl4ai": {
      "type": "stdio",
      "command": "pwsh",
      "args": ["-NoLogo", "-NoProfile", "-NonInteractive", "-Command", "$fleet = Get-Content (Join-Path $env:USERPROFILE '.agents/skills/.agent-signal-fleet.json') -Raw | ConvertFrom-Json; $root = Split-Path -Parent (Split-Path -Parent $fleet.source_snapshot); & (Join-Path $env:USERPROFILE '.local/share/crawl4ai-recovery/venv/Scripts/python.exe') -B (Join-Path $root 'integrations/crawl4ai/server.py')"],
      "timeout": 150000
    }
  }
}
