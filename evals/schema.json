{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["name", "claim", "cases"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "name": {"type": "string"},
    "claim": {"type": "string"},
    "criteria": {"type": "array", "items": {"type": "string"}},
    "receipt_schema": {"type": "object"},
    "stability": {
      "type": "object",
      "required": ["trials", "required_win_kinds"],
      "properties": {
        "trials": {"type": "integer", "minimum": 1},
        "required_win_kinds": {
          "type": "array",
          "items": {"enum": ["representative", "near-miss", "adversarial", "held-out"]},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "cases": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "prompt"],
        "properties": {
          "id": {"type": "string"},
          "kind": {"enum": ["representative", "near-miss", "adversarial", "held-out"]},
          "prompt": {"type": "string"},
          "criteria": {"type": "array", "items": {"type": "string"}},
          "must_contain": {"type": "array", "items": {"type": "string"}},
          "must_not_contain": {"type": "array", "items": {"type": "string"}},
          "expected_receipt": {"type": "object", "minProperties": 1},
          "semantic_criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "text"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "text": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["schema_version"],
        "properties": {"schema_version": {"minimum": 3}}
      },
      "then": {
        "required": ["receipt_schema", "stability"],
        "properties": {
          "cases": {
            "items": {"required": ["expected_receipt", "semantic_criteria"]}
          }
        }
      }
    }
  ]
}
