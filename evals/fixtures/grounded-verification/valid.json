{
  "$schema": "../../../contracts/grounded-verification.schema.json",
  "contract_id": "grounded-verification-human-off-pilot",
  "criteria_freeze": {
    "criteria": [
      {
        "category": "capability",
        "id": "AC-001",
        "oracle": "human-intent",
        "source_reference": "kanban:t_1e0d8e90",
        "statement": "Define distinct intent/specification, test-design, implementation, oracle, and verdict owners so no design or implementation principal can solely certify material work."
      },
      {
        "category": "correctness",
        "id": "AC-002",
        "oracle": "deterministic",
        "source_reference": "kanban:t_1e0d8e90",
        "statement": "Freeze every user-sourced acceptance criterion before implementation and require an explicit logged intent-owner decision event for every amendment."
      },
      {
        "category": "correctness",
        "id": "AC-003",
        "oracle": "deterministic",
        "source_reference": "kanban:t_1e0d8e90",
        "statement": "Give independent test authors only the frozen intent/specification and deny implementers read or edit access to held-out tests, oracle logic, rubrics, and gate recipes."
      },
      {
        "category": "correctness",
        "id": "AC-004",
        "oracle": "deterministic",
        "source_reference": "kanban:t_1e0d8e90",
        "statement": "Require independent verifiers to re-execute deterministic checks, author falsification probes, and report actual isolation strength without labeling a shared visible proxy as full independence."
      },
      {
        "category": "correctness",
        "id": "AC-005",
        "oracle": "deterministic",
        "source_reference": "kanban:t_1e0d8e90",
        "statement": "Require a demonstrated negative control for every trusted gate and property or metamorphic plus mutation or equivalent-teeth evidence for material code paths where supported."
      },
      {
        "category": "correctness",
        "id": "AC-006",
        "oracle": "world-state",
        "source_reference": "kanban:t_1e0d8e90",
        "statement": "Use out-of-band world-state evidence for open-ended outcomes and deterministic state contracts wherever ground truth is machine-checkable."
      },
      {
        "category": "capability",
        "id": "AC-007",
        "oracle": "world-state",
        "source_reference": "kanban:t_1e0d8e90",
        "statement": "Detect every known staged human-off structural blocker, including proactive status omission and phantom-assignee handling, while measuring false positives and false negatives."
      },
      {
        "category": "cost",
        "id": "AC-008",
        "oracle": "deterministic",
        "source_reference": "kanban:t_1e0d8e90",
        "statement": "Select the smallest reversible positive-net-value option using defect detection, execution and context cost, maintenance burden, Windows portability, host neutrality, and infrastructure cost; external frameworks require superior local evidence."
      },
      {
        "category": "infrastructure_burden",
        "id": "AC-009",
        "oracle": "world-state",
        "source_reference": "kanban:t_1e0d8e90",
        "statement": "Do not install or make an external verification framework authoritative without passing the full net-value evaluation."
      },
      {
        "category": "non_goal",
        "id": "AC-010",
        "oracle": "world-state",
        "source_reference": "kanban:t_1e0d8e90",
        "statement": "Do not modify, repair, or promote the staged human-off routing implementation beyond verification role separation and gate configuration."
      },
      {
        "category": "non_goal",
        "id": "AC-011",
        "oracle": "human-intent",
        "source_reference": "kanban:t_1e0d8e90",
        "statement": "Do not alter the staged human-off source intent or specification to fit the verification mechanism."
      },
      {
        "category": "portability",
        "id": "AC-012",
        "oracle": "deterministic",
        "source_reference": "kanban:t_1e0d8e90",
        "statement": "Keep the contract and validator Windows-portable and host-neutral, recording any host-native isolation limitations."
      },
      {
        "category": "rollback",
        "id": "AC-013",
        "oracle": "deterministic",
        "source_reference": "kanban:t_1e0d8e90",
        "statement": "Permit rollback by deleting the additive grounded-verification artifacts without live-state migration or changing the existing evaluation owner."
      },
      {
        "category": "correctness",
        "id": "AC-014",
        "oracle": "deterministic",
        "source_reference": "kanban:t_1e0d8e90",
        "statement": "Treat each material card as one evolving authoritative conversation that preserves later corrections, rationale, rejected or superseded approaches, evidence gaps, commitments, and open questions; generated summaries are lossy views and cannot overwrite that lineage."
      },
      {
        "category": "capability",
        "id": "AC-015",
        "oracle": "world-state",
        "source_reference": "kanban:t_1e0d8e90",
        "statement": "Default material work to brainstorm, research existing evidence, decide, execute, and independent verification, preserving the sequence and authoritative lineage across supported-host resume."
      },
      {
        "category": "correctness",
        "id": "AC-016",
        "oracle": "world-state",
        "source_reference": "kanban:t_1e0d8e90",
        "statement": "Surface material omissions proactively without user reminders and preserve the held-out second-reminder summarizer or intake omission regression."
      },
      {
        "category": "correctness",
        "id": "AC-017",
        "oracle": "deterministic",
        "source_reference": "kanban:t_1e0d8e90",
        "statement": "Risk-classify legacy done work as verified, provisionally valid, superseded, or failed from evidence; never accept done status alone as verification."
      },
      {
        "category": "capability",
        "id": "AC-018",
        "oracle": "world-state",
        "source_reference": "kanban:t_1e0d8e90",
        "statement": "Require revalidated cross-host evidence for ultimate-agent convergence and complete evidence lanes before any optional Prime Agent decision, including persistent RLM workspace, daemon continuity, child lifecycle and family messaging, bounded autonomy, rollbackable supplemental refinement, Kanban authority, sandboxing, and Windows quality."
      },
      {
        "category": "non_goal",
        "id": "AC-019",
        "oracle": "world-state",
        "source_reference": "kanban:t_1e0d8e90",
        "statement": "Do not claim downstream convergence or Prime outcomes, allow self-approved refinement or unsandboxed execution, promote unproven Windows quality, or require ordinary users to provide evaluation templates."
      }
    ],
