  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "& \"{{agent-signal:HOME}}/AppData/Local/Programs/Python/Launcher/py.exe\" -3 \"{{agent-signal:CODEX_HOME}}/hooks/windows_destructive_commands.py\"",
            "statusMessage": "Checking catastrophic Windows commands",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "^Bash$"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "& \"C:/Program Files/PowerShell/7/pwsh.exe\" -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"{{agent-signal:CODEX_HOME}}/hooks/run-gsd-check-update.ps1\"",
            "type": "command"
          }
        ]
      }
    ]
  },
