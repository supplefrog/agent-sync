{
  "approvals_reviewer": "auto_review",
  "desktop": {
    "appearanceTheme": "system",
    "conversationDetailMode": "STEPS_COMMANDS",
    "enabled-reasoning-efforts": [
      "low",
      "medium",
      "high",
      "xhigh",
      "ultra",
      "max"
    ],
    "followUpQueueMode": "queue",
    "keepRemoteControlAwakeWhilePluggedIn": true,
    "open-in-target-preferences": {
      "global": "systemDefault"
    },
    "open-link-in-target-preference": "in-app-browser",
    "selected-avatar-id": "null-signal"
  },
  "features": {
    "memories": true,
    "prevent_idle_sleep": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "& \"{{agent-signal:HOME}}/AppData/Local/Programs/Python/Launcher/py.exe\" -3 \"{{agent-signal:CODEX_HOME}}/hooks/windows_destructive_commands.py\"",
            "statusMessage": "Checking catastrophic Windows commands",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "^Bash$"
      }
    ]
  },
  "mcp_servers": {
    "claude-context": {
      "args": [
        "-NoProfile",
        "-NonInteractive",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "{{agent-signal:HOME}}\\AppData\\Local\\ClaudeContext\\claude-context-mcp.ps1"
      ],
      "command": "C:\\Program Files\\PowerShell\\7\\pwsh.exe"
    },
    "parallel": {
      "bearer_token_env_var": "PARALLEL_API_KEY",
      "url": "https://search.parallel.ai/mcp"
    },
    "tavily": {
      "bearer_token_env_var": "TAVILY_API_KEY",
      "url": "https://mcp.tavily.com/mcp"
    }
  },
  "model": "gpt-6.1-sol",
  "model_reasoning_effort": "medium",
  "personality": "pragmatic",
  "plugins": {
    "agent-ops@local-agent-skills": {
      "enabled": true
    },
    "browser@openai-bundled": {
      "enabled": true
    },
    "chrome@openai-bundled": {
      "enabled": true
    },
    "code-review@openai-bundled": {
      "enabled": true
    },
    "codex-app-tools@openai-bundled": {
      "enabled": true
    },
    "codex-security@openai-curated": {
      "enabled": true
    },
    "computer-use@openai-bundled": {
      "enabled": true
    },
    "documents@openai-primary-runtime": {
      "enabled": true
    },
    "engineering-comms@local-agent-skills": {
      "enabled": true
    },
    "github@openai-curated": {
      "enabled": false
    },
    "hermes-image-guidance@personal": {
      "enabled": false
    },
    "hyperframes@openai-curated": {
      "enabled": true
    },
    "latex@openai-bundled": {
      "enabled": true
    },
    "life-science-research@openai-curated": {
      "enabled": false
    },
    "notion@openai-curated": {
      "enabled": false
    },
    "pdf@openai-primary-runtime": {
      "enabled": true
    },
    "presentations@openai-primary-runtime": {
      "enabled": false
    },
    "research-tools@local-agent-skills": {
      "enabled": true
    },
    "spreadsheets@openai-primary-runtime": {
      "enabled": true
    },
    "template-creator@openai-primary-runtime": {
      "enabled": true
    },
    "unified-computer-use@openai-bundled": {
      "enabled": true
    },
    "visualize@openai-bundled": {
      "enabled": true
    }
  },
  "service_tier": "default",
  "skills": {
    "config": [
      {
        "enabled": false,
        "name": "notion:notion-meeting-intelligence"
      },
      {
        "enabled": false,
        "name": "notion:notion-spec-to-implementation"
      },
      {
        "enabled": false,
        "path": "{{agent-signal:CODEX_HOME}}\\skills\\sora\\SKILL.md"
      },
      {
        "enabled": false,
        "name": "presentations:Presentations"
      },
      {
        "enabled": false,
        "name": "spreadsheets:Spreadsheets"
      },
      {
        "enabled": false,
        "name": "documents:documents"
      },
      {
        "enabled": false,
        "path": "{{agent-signal:CODEX_HOME}}\\skills\\pdf\\SKILL.md"
      },
      {
        "enabled": false,
        "name": "agent-ops:resourceful-agent"
      },
      {
        "enabled": false,
        "name": "agent-ops:personal-ops-agent"
      },
      {
        "enabled": false,
        "name": "browser-use:browser"
      },
      {
        "enabled": false,
        "name": "agent-ops:project-bootstrap"
      },
      {
        "enabled": false,
        "path": "{{agent-signal:CODEX_HOME}}\\skills\\paseo\\SKILL.md"
      },
      {
        "enabled": false,
        "path": "{{agent-signal:CODEX_HOME}}\\skills\\paseo-help\\SKILL.md"
      },
      {
        "enabled": false,
        "path": "{{agent-signal:CODEX_HOME}}\\skills\\paseo-advisor\\SKILL.md"
      },
      {
        "enabled": false,
        "path": "{{agent-signal:CODEX_HOME}}\\skills\\paseo-committee\\SKILL.md"
      },
      {
        "enabled": false,
        "path": "{{agent-signal:CODEX_HOME}}\\skills\\paseo-handoff\\SKILL.md"
      },
      {
        "enabled": false,
        "path": "{{agent-signal:CODEX_HOME}}\\skills\\paseo-plugin\\SKILL.md"
      }
    ]
  },
  "windows": {
    "sandbox": "unelevated"
  }
}
