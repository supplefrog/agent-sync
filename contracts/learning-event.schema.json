{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://supplefrog.github.io/agent-signal/contracts/learning-event.schema.json",
  "title": "Verified global-agent learning event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_type", "source_ref", "observed_at", "scope", "behavior_class", "verification", "lesson"],
  "properties": {
    "schema_version": {"const": 1},
    "source_type": {"enum": ["user-correction", "verified-task-failure", "successful-comparison", "github-outcome", "model-runtime-change", "external-research"]},
    "source_ref": {"type": "string", "minLength": 1, "maxLength": 500, "pattern": "^[^\\r\\n]+$"},
    "observed_at": {"type": "string", "format": "date-time"},
    "scope": {"enum": ["global", "cross-project", "project", "user"]},
    "behavior_class": {"enum": ["generic-judgment", "reusable-procedure", "runtime-mechanic", "github-workflow", "safety-governance", "project-convention", "user-preference", "environment-fact"]},
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence_refs"],
      "properties": {
        "status": {"const": "verified"},
        "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 500, "pattern": "^[^\\r\\n]+$"}}
      }
    },
    "lesson": {"$ref": "#/$defs/lesson"}
  },
  "$defs": {
    "lesson": {
      "type": "object",
      "additionalProperties": false,
      "required": ["problem", "better_behavior", "near_miss"],
      "properties": {
        "problem": {"type": "string", "minLength": 1, "maxLength": 1000},
        "better_behavior": {"type": "string", "minLength": 1, "maxLength": 1000},
        "near_miss": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    }
  }
}
