{
  "$schema": "contracts/instruction-surfaces.schema.json",
  "schema_version": 1,
  "precedence_rule": "Higher precedence is applied later and wins on conflict; runtime-native and provider-native surfaces remain externally owned.",
  "exclusions": [
    "Skills and tool schemas are on-demand capabilities, not standing instruction surfaces.",
    "Credentials, auth state, memory, sessions, logs, caches, and generated plugin caches are never instruction sources or recovery artifacts.",
    "Project-local instruction files are discovered at runtime and remain owned by their project unless explicitly admitted elsewhere."
  ],
  "surfaces": [
    {
      "id": "portable.core-reference",
      "hosts": ["codex", "hermes", "omp"],
      "kind": "portable-reference",
      "scope": "user-global",
      "status": "reference",
      "owner": "surfaces/core.md",
      "artifact": "surfaces/core.md",
      "precedence": 0,
      "model_sensitive": true,
      "backup": "not-effective",
      "note": "Portable intent and retirement source; adapters do not inject this file verbatim."
    },
    {
      "id": "provider.native-system",
      "hosts": ["provider"],
      "kind": "provider-native",
      "scope": "provider",
      "status": "external",
      "owner": "provider runtime",
      "target": "provider-managed hidden system instructions",
      "precedence": 100,
      "model_sensitive": true,
      "backup": "reinstall-runtime",
      "note": "Not user-readable or safely representable as one portable file."
    },
    {
      "id": "hermes.runtime-native",
      "hosts": ["hermes"],
      "kind": "runtime-native",
      "scope": "runtime",
      "status": "external",
      "owner": "NousResearch/hermes-agent@0.20.5",
      "target": "Hermes prompt builder",
      "precedence": 110,
      "model_sensitive": true,
      "backup": "reinstall-runtime"
    },
    {
      "id": "hermes.user-global",
      "hosts": ["hermes"],
      "kind": "user-global",
      "scope": "user-global",
      "status": "active",
      "owner": "recovery/current/hosts/hermes/SOUL.md",
      "artifact": "recovery/current/hosts/hermes/SOUL.md",
      "target": "${HERMES_HOME}/SOUL.md",
      "precedence": 200,
      "model_sensitive": true,
      "backup": "captured"
    },
    {
      "id": "hermes.project-context",
      "hosts": ["hermes"],
      "kind": "project-dynamic",
      "scope": "project",
      "status": "dynamic",
      "owner": "current project",
      "target": "workdir ancestor chain",
      "patterns": ["AGENTS.md", "CLAUDE.md", ".cursorrules"],
      "precedence": 300,
      "model_sensitive": false,
      "backup": "project-owned"
    },
    {
      "id": "codex.runtime-native",
      "hosts": ["codex"],
      "kind": "runtime-native",
      "scope": "runtime",
      "status": "external",
      "owner": "openai/codex@0.150.0-alpha.12.2",
      "target": "Codex prompt builder",
      "precedence": 110,
      "model_sensitive": true,
      "backup": "reinstall-runtime"
    },
    {
      "id": "codex.user-global",
      "hosts": ["codex", "omp"],
      "kind": "user-global",
      "scope": "user-global",
      "status": "active",
      "owner": "recovery/current/hosts/codex/AGENTS.md",
      "artifact": "recovery/current/hosts/codex/AGENTS.md",
      "target": "${CODEX_HOME}/AGENTS.md",
      "precedence": 200,
      "model_sensitive": true,
      "backup": "captured",
      "note": "Current observed drift: the INSTRUCTION-AUTHORING line still names the disabled local agent-surface-curator. Replacing that protected AGENTS.md line requires explicit user approval; the profile preserves and reports the current bytes rather than silently rewriting them."
    },
    {
      "id": "codex.session-start-hook",
      "hosts": ["codex"],
      "kind": "hook-injection",
      "scope": "session",
      "status": "active",
      "owner": "recovery/current/hosts/codex/hooks/run-gsd-check-update.ps1",
      "artifact": "recovery/current/hosts/codex/hooks/run-gsd-check-update.ps1",
      "target": "${CODEX_HOME}/hooks/run-gsd-check-update.ps1",
      "precedence": 250,
      "model_sensitive": false,
      "backup": "captured",
      "note": "Operational session-start output only; not a standing prose owner."
    },
    {
      "id": "codex.project-context",
      "hosts": ["codex", "omp"],
      "kind": "project-dynamic",
      "scope": "project",
      "status": "dynamic",
      "owner": "current project",
      "target": "Codex AGENTS hierarchy",
      "patterns": ["AGENTS.md"],
      "precedence": 300,
      "model_sensitive": false,
      "backup": "project-owned"
    },
    {
      "id": "codex.surface-curator-plugin",
      "hosts": ["codex"],
      "kind": "hook-injection",
      "scope": "session",
      "status": "disabled",
      "owner": "local agent-surface-governance plugin",
      "target": "Codex plugin hooks",
      "precedence": 350,
      "model_sensitive": false,
      "backup": "not-effective",
      "replacement": "skills/capability-curator",
      "note": "The earlier surface curator guarded edits and retirement decisions; it did not own every effective instruction."
    },
    {
      "id": "omp.runtime-native",
      "hosts": ["omp"],
      "kind": "runtime-native",
      "scope": "runtime",
      "status": "external",
      "owner": "oh-my-pi@17.2.13",
      "target": "OMP prompt builder",
      "precedence": 110,
      "model_sensitive": true,
      "backup": "reinstall-runtime"
    },
    {
      "id": "omp.codex-inherited",
      "hosts": ["omp"],
      "kind": "inherited",
      "scope": "user-global",
      "status": "active",
      "owner": "codex.user-global",
      "artifact": "recovery/current/hosts/codex/AGENTS.md",
      "target": "Codex-compatible AGENTS inheritance",
      "precedence": 200,
      "model_sensitive": true,
      "backup": "captured",
      "note": "OMP v17.2.13's codex discovery provider loads ~/.codex/AGENTS.md at user scope. No native ~/.omp/agent/AGENTS.md is present to shadow it; source: https://github.com/can1357/oh-my-pi/blob/v17.2.13/docs/context-files.md"
    },
    {
      "id": "omp.rules-delta",
      "hosts": ["omp"],
      "kind": "user-global",
      "scope": "user-global",
      "status": "retired",
      "owner": "recovery/current/hosts/omp/RULES.md",
      "artifact": "recovery/current/hosts/omp/RULES.md",
      "target": "${OMP_HOME}/RULES.md",
      "precedence": 210,
      "model_sensitive": true,
      "backup": "retired",
      "replacement": "codex.user-global",
      "note": "Duplicated the inherited output rule and added standing context without a distinct behavior."
    },
    {
      "id": "omp.project-context",
      "hosts": ["omp"],
      "kind": "project-dynamic",
      "scope": "project",
      "status": "dynamic",
      "owner": "current project",
      "target": "OMP/Codex project hierarchy",
      "patterns": ["AGENTS.md"],
      "precedence": 300,
      "model_sensitive": false,
      "backup": "project-owned"
    }
  ]
}
