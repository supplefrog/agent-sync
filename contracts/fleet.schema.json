{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "snapshot_root", "machines"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "snapshot_root": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "machines": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["role", "platform", "skill_roots", "hosts"],
        "properties": {
          "role": {"type": "string", "minLength": 1},
          "platform": {"enum": ["windows", "linux", "darwin"]},
          "skill_roots": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "hosts": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["hermes", "codex", "omp"]}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
