{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "change-request.schema.json",
  "title": "Agent Signal reconciled change request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "machine", "phase", "operation", "source", "risk", "disposition", "owners", "artifacts", "phases", "checks", "result"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "request_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "machine": {"type": "string", "minLength": 1},
    "phase": {"enum": ["completed", "review-required", "rejected"]},
    "operation": {"enum": ["classify-change", "adopt-existing-owner", "deploy-canonical-owner", "capture-recovery", "mixed-safe-reconciliation"]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "surface"],
      "properties": {
        "host": {"type": "string", "minLength": 1},
        "surface": {"enum": ["fleet", "recovery", "mixed"]}
      }
    },
    "risk": {"enum": ["low", "review", "high"]},
    "disposition": {"enum": ["applied", "review-required", "rejected", "unchanged"]},
    "owners": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["owner", "source", "before_sha256", "after_sha256"],
        "properties": {
          "owner": {"type": "string"},
          "source": {"enum": ["live", "canonical"]},
          "before_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "after_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status"],
        "properties": {
          "name": {"enum": ["classify", "preflight", "canonicalize", "render", "validate", "deploy", "verify", "receipt"]},
          "status": {"enum": ["completed", "skipped", "failed"]}
        }
      }
    },
    "checks": {"type": "array", "items": {"type": "string"}},
    "result": {"enum": ["applied", "unchanged", "review-required", "rejected"]}
  }
}
