{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://supplefrog.github.io/agent-signal/contracts/recovery-snapshot.schema.json",
  "title": "Agent Sync public-safe recovery snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "machine",
    "public_safe",
    "policy_sha256",
    "artifacts"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "machine": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "public_safe": {"const": true},
    "policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "host",
          "id",
          "kind",
          "source",
          "snapshot",
          "format",
          "strategy",
          "include",
          "sha256",
          "bytes"
        ],
        "properties": {
          "host": {"enum": ["hermes", "codex", "omp"]},
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "kind": {"enum": ["config", "text"]},
          "source": {"type": "string", "minLength": 1},
          "snapshot": {"type": "string", "minLength": 1},
          "format": {"enum": ["json", "yaml", "toml", "text"]},
          "strategy": {"enum": ["merge", "replace-if-absent"]},
          "include": {
            "type": "array",
            "items": {"type": "string"},
            "uniqueItems": true
          },
          "portable_paths": {"type": "boolean"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
