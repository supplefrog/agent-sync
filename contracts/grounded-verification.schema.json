{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-signal.local/contracts/grounded-verification.schema.json",
  "title": "Independent grounded verification contract",
  "type": "object",
  "required": [
    "schema_version", "contract_id", "state", "source_intent", "criteria_freeze",
    "roles", "isolation", "test_author_receipt", "verification_receipt", "gates", "material_code_paths", "decision_evidence",
    "verifier", "verdict", "pilot", "rollback"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "contract_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "state": {"enum": ["frozen", "implementation-sealed", "verified", "rejected", "inconclusive"]},
    "source_intent": {
      "type": "object",
      "required": ["authority", "reference", "captured_at", "statement"],
      "properties": {
        "authority": {"enum": ["user", "approved-decision"]},
        "reference": {"type": "string", "minLength": 1},
        "captured_at": {"type": "string", "format": "date-time"},
        "statement": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "criteria_freeze": {
      "type": "object",
      "required": ["frozen_at", "implementation_started_at", "criteria_sha256", "freeze_receipt_path", "freeze_receipt", "criteria", "pilot_manifest", "decision_scopes", "decision_events"],
      "properties": {
        "frozen_at": {"type": "string", "format": "date-time"},
        "implementation_started_at": {"type": "string", "format": "date-time"},
        "criteria_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "freeze_receipt_path": {"type": "string", "minLength": 1},
        "freeze_receipt": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "criteria": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "object",
            "required": ["id", "category", "statement", "source_reference", "oracle"],
            "properties": {
              "id": {"type": "string", "pattern": "^AC-[0-9]{3}$"},
              "category": {"enum": ["capability", "infrastructure_burden", "cost", "portability", "non_goal", "rollback", "correctness"]},
              "statement": {"type": "string", "minLength": 1},
              "source_reference": {"type": "string", "minLength": 1},
              "oracle": {"enum": ["deterministic", "world-state", "human-intent"]}
            },
            "additionalProperties": false
          }
        },
        "pilot_manifest": {
          "type": "object",
          "required": ["expected_blocker_ids", "expected_non_regression_ids"],
          "properties": {
            "expected_blocker_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
            "expected_non_regression_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
          },
          "additionalProperties": false
        },
        "decision_scopes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "decision_type", "criterion_ids", "required_evidence_lanes", "required_gate_ids"],
            "properties": {
              "id": {"type": "string", "pattern": "^S-[A-Z0-9-]+$"},
              "decision_type": {"enum": ["verification", "candidate-comparison", "architecture", "promotion"]},
              "criterion_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^AC-[0-9]{3}$"}, "uniqueItems": true},
              "required_evidence_lanes": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}, "uniqueItems": true},
              "required_gate_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^G-[A-Z0-9-]+$"}, "uniqueItems": true}
            },
            "additionalProperties": false
          }
        },
        "decision_events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "decided_at", "decided_by", "reason", "before_sha256", "after_sha256"],
            "properties": {
              "id": {"type": "string", "pattern": "^DEC-[0-9]{3}$"},
              "decided_at": {"type": "string", "format": "date-time"},
              "decided_by": {"type": "string"},
              "reason": {"type": "string", "minLength": 1},
              "before_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "after_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "roles": {
      "type": "object",
      "required": ["intent_owner", "specification_owner", "test_author", "implementer", "oracle_owner", "verdict_owner"],
      "additionalProperties": {
        "type": "object",
        "required": ["principal_id", "context_id"],
        "properties": {
          "principal_id": {"type": "string", "pattern": "^p_[a-f0-9]{8,64}$"},
          "context_id": {"type": "string", "pattern": "^c_[a-f0-9]{8,64}$"}
        },
        "additionalProperties": false
      }
    },
    "isolation": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["subject_role", "readable_scopes", "denied_scopes", "enforcement", "receipt_path", "receipt"],
        "properties": {
          "subject_role": {"enum": ["test_author", "implementer", "oracle_owner", "verdict_owner"]},
          "readable_scopes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "denied_scopes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "enforcement": {"enum": ["separate-workspace", "filesystem-acl", "sandbox", "process-boundary"]},
          "receipt_path": {"type": "string", "minLength": 1},
          "receipt": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "test_author_receipt": {
      "type": "object",
      "required": ["receipt_path", "receipt", "artifact_path", "artifact_sha256"],
      "properties": {
        "receipt_path": {"type": "string", "minLength": 1},
        "receipt": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "artifact_path": {"type": "string", "minLength": 1},
        "artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "verification_receipt": {
      "type": "object",
      "required": ["receipt_path", "receipt"],
      "properties": {
        "receipt_path": {"type": "string", "minLength": 1},
        "receipt": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "trusted", "check_kind", "oracle", "open_ended", "command_or_probe", "evidence_path", "result", "negative_control"],
        "properties": {
          "id": {"type": "string", "pattern": "^G-[A-Z0-9-]+$"},
          "trusted": {"type": "boolean"},
          "check_kind": {"enum": ["deterministic", "property", "metamorphic", "mutation", "equivalent-teeth", "inspection", "world-state"]},
          "oracle": {"enum": ["deterministic", "world-state", "human-intent"]},
          "open_ended": {"type": "boolean"},
          "command_or_probe": {"type": "string", "minLength": 1},
          "evidence_path": {"type": "string", "minLength": 1},
          "result": {"enum": ["pass", "fail", "inconclusive"]},
          "negative_control": {
            "type": "object",
            "required": ["fault", "expected", "observed", "passed"],
            "properties": {
              "fault": {"type": "string", "minLength": 1},
              "expected": {"enum": ["fail", "reject"]},
              "observed": {"enum": ["fail", "reject", "pass", "inconclusive"]},
              "passed": {"type": "boolean"}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "material_code_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "property_or_metamorphic_gate", "teeth_gate", "teeth_supported"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "property_or_metamorphic_gate": {"type": "string"},
          "teeth_gate": {"type": ["string", "null"]},
          "teeth_supported": {"type": "boolean"},
          "exemption": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "decision_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["scope_id", "lanes"],
        "properties": {
          "scope_id": {"type": "string", "pattern": "^S-[A-Z0-9-]+$"},
          "lanes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["lane_id", "evidence_path", "sha256", "result"],
              "properties": {
                "lane_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
                "evidence_path": {"type": "string", "minLength": 1},
                "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
                "result": {"enum": ["pass", "fail", "inconclusive"]}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "verifier": {
      "type": "object",
      "required": ["principal_id", "context_id", "isolation_strength", "shared_visible_proxy", "reexecuted_gate_ids", "falsification_probes", "limitations"],
      "properties": {
        "principal_id": {"type": "string"},
        "context_id": {"type": "string"},
        "isolation_strength": {"enum": ["none", "context-only", "workspace-isolated", "principal-and-workspace-isolated"]},
        "shared_visible_proxy": {"type": "boolean"},
        "reexecuted_gate_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "falsification_probes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "limitations": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "verdict": {
      "type": "object",
      "required": ["principal_id", "decision", "basis_gate_ids", "claimed_scope_ids"],
      "properties": {
        "principal_id": {"type": "string"},
        "decision": {"enum": ["pass", "reject", "inconclusive"]},
        "basis_gate_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "claimed_scope_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^S-[A-Z0-9-]+$"}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "pilot": {
      "type": "object",
      "required": ["subject", "evidence_path", "known_blockers", "false_positives", "false_negatives", "runtime_seconds", "model_cost_usd", "context_tokens", "maintenance_minutes", "windows_portability", "host_neutrality"],
      "properties": {
        "subject": {"type": "string", "minLength": 1},
        "evidence_path": {"type": "string", "minLength": 1},
        "known_blockers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "expected", "detected", "classification", "evidence_path"],
            "properties": {
              "id": {"type": "string"},
              "expected": {"enum": ["blocker", "non-regression"]},
              "detected": {"type": "boolean"},
              "classification": {"type": "string", "minLength": 1},
              "evidence_path": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "false_positives": {"type": "integer", "minimum": 0},
        "false_negatives": {"type": "integer", "minimum": 0},
        "runtime_seconds": {"type": "number", "minimum": 0},
        "model_cost_usd": {"type": "number", "minimum": 0},
        "context_tokens": {"type": "integer", "minimum": 0},
        "maintenance_minutes": {"type": "number", "minimum": 0},
        "windows_portability": {"enum": ["pass", "fail", "not-run"]},
        "host_neutrality": {"enum": ["pass", "fail", "partial"]}
      },
      "additionalProperties": false
    },
    "rollback": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
