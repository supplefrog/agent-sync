{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://supplefrog.github.io/agent-signal/contracts/model-profile.schema.json",
  "title": "Agent Sync model-qualified instruction profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "status", "claim", "target", "contracts", "hosts", "writing_routes", "context_policy", "retest_on", "evidence"],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "status": {"enum": ["candidate", "current-observed", "superseded"]},
    "claim": {"type": "string", "minLength": 1},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "provider", "reasoning"],
      "properties": {
        "model": {"type": "string", "minLength": 1},
        "provider": {"type": "string", "minLength": 1},
        "reasoning": {"type": "string", "minLength": 1}
      }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surfaces", "units", "recovery_manifest"],
      "properties": {
        "surfaces": {"type": "string", "minLength": 1},
        "units": {"type": "string", "minLength": 1},
        "recovery_manifest": {"type": "string", "minLength": 1}
      }
    },
    "hosts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codex", "hermes", "omp"],
      "properties": {
        "codex": {"$ref": "#/$defs/host"},
        "hermes": {"$ref": "#/$defs/host"},
        "omp": {"$ref": "#/$defs/host"}
      }
    },
    "writing_routes": {
      "type": "object",
      "minProperties": 4,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["owner", "loading", "scope"],
        "properties": {
          "owner": {"type": "string", "minLength": 1},
          "loading": {"enum": ["standing", "on-demand"]},
          "scope": {"type": "string", "minLength": 1}
        }
      }
    },
    "context_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recovery_loaded_into_prompt", "skills", "tools", "max_standing_bytes"],
      "properties": {
        "recovery_loaded_into_prompt": {"const": false},
        "skills": {"const": "on-demand"},
        "tools": {"const": "host-native-on-demand"},
        "max_standing_bytes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["codex", "hermes", "omp"],
          "properties": {
            "codex": {"type": "integer", "minimum": 1},
            "hermes": {"type": "integer", "minimum": 1},
            "omp": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "retest_on": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "evidence": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "reasoning", "effective_surfaces", "effective_units", "artifact_sha256"],
      "properties": {
        "runtime": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "provider": {"type": "string", "minLength": 1},
        "reasoning": {"type": "string", "minLength": 1},
        "effective_surfaces": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "effective_units": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "artifact_sha256": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
        "no_managed_standing_reason": {"type": "string", "minLength": 1}
      },
      "oneOf": [
        {
          "properties": {
            "effective_units": {"minItems": 1},
            "artifact_sha256": {"minItems": 1}
          },
          "not": {"required": ["no_managed_standing_reason"]}
        },
        {
          "required": ["no_managed_standing_reason"],
          "properties": {
            "effective_units": {"maxItems": 0},
            "artifact_sha256": {"maxItems": 0}
          }
        }
      ]
    }
  }
}
